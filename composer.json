{
    "name": "mirivlad/tms",
    "description": "Lightweight self-hosted task management system",
    "type": "project",
    "license": "AGPL-3.0-or-later",
    "require": {
        "php": "^8.2",
        "ext-dom": "*",
        "ext-pdo": "*",
        "slim/slim": "^4.0",
        "slim/psr7": "^1.8",
        "slim/http": "^1.4",
        "slim/twig-view": "^3.4",
        "monolog/monolog": "^3.9",
        "vlucas/phpdotenv": "^5.6",
        "phpmailer/phpmailer": "^6.8",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Tms\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tms\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "analyse": "phpstan analyse --no-progress",
        "test": "phpunit",
        "check": [
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": false
    }
}
