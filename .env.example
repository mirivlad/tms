# Application
APP_ENV=production
APP_DEBUG=false
APP_URL=https://tms.example.com
APP_TIMEZONE=UTC

# Database
DB_HOST=db
DB_PORT=3306
DB_NAME=tms
DB_USER=tms
DB_PASS=change-me

# Session
SESSION_NAME=tms_session
# Keep true in production. Set false only for explicit local HTTP development.
SESSION_SECURE=true
SESSION_SAMESITE=Lax

# Mail defaults. Per-user SMTP settings may override these later.
MAIL_FROM_ADDRESS=tms@example.invalid
MAIL_FROM_NAME=TMS

# Telegram integration is optional. Do not commit real tokens.
TELEGRAM_BOT_TOKEN=
