# Application
APP_ENV=production
APP_DEBUG=false
APP_URL=https://tms.example.com
APP_TIMEZONE=UTC
# Supported interface locales: en, ru
APP_LOCALE=en

# Docker/Compose host port
TMS_PORT=8080

# Database
DB_HOST=db
DB_PORT=3306
DB_NAME=tms
DB_USER=tms
DB_PASS=change-me

# Session
SESSION_NAME=tms_session
# Keep true when users access TMS through HTTPS. Set false only for explicit HTTP deployments.
SESSION_SECURE=true
SESSION_SAMESITE=Lax

# Persistent login
REMEMBER_COOKIE_NAME=tms_remember
REMEMBER_DAYS=30

# Attachments
ATTACHMENT_STORAGE_PATH=/var/www/html/var/storage/attachments
ATTACHMENT_MAX_BYTES=10485760

# Notifications
# Generate with: php -r 'echo base64_encode(random_bytes(32)), PHP_EOL;'
# Required only when storing an SMTP password in TMS.
NOTIFICATION_SECRET=
# Scheduler interval in seconds for Docker/Portainer notifier service.
NOTIFICATION_INTERVAL_SECONDS=60
# Optional Telegram bot integration. WEBHOOK_SECRET should be a strong random URL-safe value.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_NAME=
TELEGRAM_WEBHOOK_SECRET=

# Mail defaults retained for future account/auth mail flows.
MAIL_FROM_ADDRESS=tms@example.invalid
MAIL_FROM_NAME=TMS
