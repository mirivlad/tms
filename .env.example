# Application
APP_ENV=production
APP_DEBUG=false
APP_URL=https://tms.example.com
APP_TIMEZONE=UTC
# Supported interface locales: en, ru
APP_LOCALE=en

# Docker/Compose host port
TMS_PORT=8080
# compose.portainer.yaml only: optional image override. Leave unset to use the pinned stable image.
# TMS_IMAGE=ghcr.io/mirivlad/tms:v0.2.7

# Database
DB_HOST=db
DB_PORT=3306
DB_NAME=tms
DB_USER=tms
DB_PASS=change-me

# Session
SESSION_NAME=tms_session
# Keep true when users access TMS through HTTPS. Set false only for explicit HTTP deployments.
SESSION_SECURE=true
SESSION_SAMESITE=Lax

# Persistent login
REMEMBER_COOKIE_NAME=tms_remember
REMEMBER_DAYS=30

# Optional self-registration. Keep disabled for closed/private installations.
REGISTRATION_ENABLED=false
# When true, successful email verification also approves the account.
# Set false when an administrator must approve every new account manually.
REGISTRATION_AUTO_APPROVE_AFTER_EMAIL=true

# Attachments
ATTACHMENT_STORAGE_PATH=/var/www/html/var/storage/attachments
ATTACHMENT_MAX_BYTES=10485760

# Notifications
# Optional encryption-key override. When empty, TMS creates a persistent key in tms-secrets.
# Generate an external key with: php -r 'echo base64_encode(random_bytes(32)), PHP_EOL;'
NOTIFICATION_SECRET=
NOTIFICATION_SECRET_FILE=/var/www/html/var/secrets/notification.key
# Scheduler interval in seconds for recurring tasks and notifications.
NOTIFICATION_INTERVAL_SECONDS=60
# Outbound webhook delivery worker interval in seconds.
WEBHOOK_INTERVAL_SECONDS=15
# Optional Telegram bootstrap/fallback values. Prefer Administration -> System notifications.
# WEBHOOK_SECRET is required only for webhook mode and must be URL-safe. Proxy supports http(s), socks5 and socks5h URLs.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_NAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_PROXY_ENABLED=false
TELEGRAM_PROXY_URL=
