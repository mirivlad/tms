# Application
APP_ENV=production
APP_DEBUG=false
APP_URL=https://tms.example.com
APP_TIMEZONE=UTC
# Supported interface locales: en, ru
APP_LOCALE=en

# Docker/Compose host port
TMS_PORT=8080

# Database
DB_HOST=db
DB_PORT=3306
DB_NAME=tms
DB_USER=tms
DB_PASS=change-me

# Session
SESSION_NAME=tms_session
# Keep true when users access TMS through HTTPS. Set false only for explicit HTTP deployments.
SESSION_SECURE=true
SESSION_SAMESITE=Lax

# Persistent login
REMEMBER_COOKIE_NAME=tms_remember
REMEMBER_DAYS=30

# Attachments
# Must resolve outside the public web root and be writable by the PHP process.
ATTACHMENT_STORAGE_PATH=/var/www/html/var/storage/attachments
# Per-file limit in bytes. Default: 10 MiB.
ATTACHMENT_MAX_BYTES=10485760

# Mail defaults. Per-user SMTP settings may override these later.
MAIL_FROM_ADDRESS=tms@example.invalid
MAIL_FROM_NAME=TMS

# Telegram integration is optional. Do not commit real tokens.
TELEGRAM_BOT_TOKEN=
