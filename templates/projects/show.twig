{% extends 'app_layout.twig' %}
{% block title %}{{ project.name }} · TMS{% endblock %}
{% block styles %}<link rel="stylesheet" href="/assets/metadata.css"><link rel="stylesheet" href="/assets/collaboration.css"><link rel="stylesheet" href="/assets/discussions.css">{% endblock %}
{% set project_section = 'overview' %}

{% block content %}
{% include 'projects/_nav.twig' %}

<div class="entity-overview-grid">
    <section class="content-card overview-span-2">
        <div class="section-heading">
            <div><h2>{{ t('projects.overview_about') }}</h2></div>
        </div>
        {% if project.description %}<p class="project-description">{{ project.description|nl2br }}</p>{% else %}<p class="muted">{{ t('projects.overview_no_description') }}</p>{% endif %}
        <div class="overview-facts">
            <div><span>{{ t('projects.status') }}</span><strong>{{ t('projects.status.' ~ project.lifecycleStatus) }}</strong></div>
            <div><span>{{ t('projects.owner') }}</span><strong>{{ project_team ? project_team.name : t('projects.personal') }}</strong></div>
            <div><span>{{ t('projects.overview_tasks') }}</span><strong>{{ task_count }}</strong></div>
            <div><span>{{ t('projects.overview_files') }}</span><strong>{{ attachment_count }}</strong></div>
        </div>
    </section>

    <section class="content-card">
        <div class="section-heading">
            <div><h2>{{ t('projects.overview_task_state') }}</h2></div>
            <a href="/tasks?project={{ project.id }}">{{ t('projects.open_task_list') }}</a>
        </div>
        <div class="overview-metrics">
            <div><strong>{{ open_task_count }}</strong><span>{{ t('projects.overview_open_tasks') }}</span></div>
            <div><strong>{{ completed_task_count }}</strong><span>{{ t('projects.overview_completed_tasks') }}</span></div>
        </div>
        <div class="overview-status-list">
            {% for item in status_summary %}
                <div><span><span class="status-dot" style="--status-color: {{ item.status.color }}"></span>{{ item.status.name }}</span><strong>{{ item.count }}</strong></div>
            {% endfor %}
        </div>
    </section>

    <section class="content-card">
        <div class="section-heading">
            <div><h2>{{ t('projects.fields_title') }}</h2></div>
            {% if can_manage %}<a href="/projects/{{ project.id }}/fields">{{ t('projects.action_fields') }}</a>{% endif %}
        </div>
        {% if custom_fields is empty %}
            <p class="muted">{{ t('projects.fields_empty') }}</p>
        {% else %}
            <div class="overview-chip-list">
                {% for field in custom_fields %}<span class="metadata-badge">{{ field.name }} · {{ t('custom_fields.type.' ~ field.type) }}</span>{% endfor %}
            </div>
        {% endif %}
    </section>

    <section class="content-card">
        <div class="section-heading">
            <div><h2>{{ t('projects.workflow_title') }}</h2></div>
            {% if can_manage %}<a href="/projects/{{ project.id }}/statuses">{{ t('projects.action_statuses') }}</a>{% endif %}
        </div>
        <div class="overview-chip-list">
            {% for status in statuses %}
                <span class="metadata-badge"><span class="status-dot" style="--status-color: {{ status.color }}"></span>{{ status.name }}</span>
            {% endfor %}
        </div>
    </section>

    <section class="content-card">
        <div class="section-heading">
            <div><h2>{{ t('projects.files') }}</h2></div>
            <a href="/projects/{{ project.id }}/files">{{ t('projects.action_files') }}</a>
        </div>
        <p class="overview-big-number">{{ attachment_count }}</p>
        <p class="muted">{{ t('projects.overview_files_help') }}</p>
    </section>

    {% if discussion_enabled %}
    <section class="content-card overview-span-2">
        <div class="section-heading">
            <div>
                <h2>{{ t('projects.discussion_title') }}</h2>
                <p class="muted">{{ t('projects.overview_discussion_help', {'count': discussion_count}) }}</p>
            </div>
            <a class="discussion-link" href="/projects/{{ project.id }}/discussion">
                {{ t('projects.action_discussion') }}
                <span class="count-badge">{{ discussion_count }}</span>
                {% if discussion_unread > 0 %}<span class="discussion-unread-badge">{{ discussion_unread }}</span>{% endif %}
            </a>
        </div>
        {% if recent_discussion is empty %}
            <p class="muted">{{ t('projects.overview_no_discussion') }}</p>
        {% else %}
            <div class="overview-activity-list">
                {% for activity in recent_discussion %}
                    <article>
                        <strong>{{ activity.comment.authorUsername|default(t('discussions.deleted_user')) }}</strong>
                        <span class="muted">{{ activity.comment.updatedAt }}</span>
                        {% if activity.task_title %}<span class="metadata-badge">{{ activity.task_title }}</span>{% endif %}
                        <div>{{ sanitize_task_html(activity.comment.bodyHtml)|raw }}</div>
                    </article>
                {% endfor %}
            </div>
        {% endif %}
    </section>
    {% endif %}
</div>
{% endblock %}
