{% extends 'app_layout.twig' %}

{% block title %}{{ project.name }} · TMS{% endblock %}
{% block styles %}<link rel="stylesheet" href="/assets/task-form.css">{% endblock %}

{% block content %}
<header class="page-header compact-page-header">
    <div>
        <h1>{{ project.name }}</h1>
        <p class="muted">{{ t('projects.status.' ~ project.lifecycleStatus) }} · {{ t('projects.personal') }}</p>
    </div>
    <div class="page-header-actions">
        <a class="button-link" href="/tasks/new?project_id={{ project.id }}">{{ t('projects.add_task') }}</a>
        <a class="text-link" href="/projects">{{ t('projects.back') }}</a>
    </div>
</header>

{% if project.description %}
<section class="content-card">
    <p class="project-description">{{ project.description|nl2br }}</p>
</section>
{% endif %}

<section class="content-card attachment-card">
    <div class="attachment-heading">
        <div>
            <h2>{{ t('projects.files') }}</h2>
            <p class="muted">{{ t('attachments.help', {'size': attachment_max_mib, 'extensions': attachment_allowed_extensions|join(', ')}) }}</p>
        </div>
    </div>

    <form class="attachment-upload" method="post" action="/projects/{{ project.id }}/attachments" enctype="multipart/form-data">
        <input type="hidden" name="_csrf" value="{{ csrf_token }}">
        <label>
            {{ t('attachments.choose') }}
            <input type="file" name="attachments[]" multiple required>
        </label>
        <button type="submit">{{ t('attachments.upload') }}</button>
    </form>

    {% if attachments is empty %}
        <p class="muted attachment-empty">{{ t('projects.files_empty') }}</p>
    {% else %}
        <div class="attachment-list">
            {% for attachment in attachments %}
                <div class="attachment-row">
                    <div class="attachment-details">
                        <a class="text-link attachment-name" href="/projects/{{ project.id }}/attachments/{{ attachment.id }}">{{ attachment.originalName }}</a>
                        <span class="muted attachment-meta">
                            {% if attachment.fileSize >= 1048576 %}
                                {{ (attachment.fileSize / 1048576)|number_format(1, '.', ' ') }} MiB
                            {% else %}
                                {{ (attachment.fileSize / 1024)|number_format(1, '.', ' ') }} KiB
                            {% endif %}
                            · {{ attachment.createdAt }}
                        </span>
                    </div>
                    <form method="post" action="/projects/{{ project.id }}/attachments/{{ attachment.id }}/delete" onsubmit="return confirm('{{ t('attachments.delete_confirm')|e('js') }}')">
                        <input type="hidden" name="_csrf" value="{{ csrf_token }}">
                        <button type="submit" class="secondary compact">{{ t('attachments.delete') }}</button>
                    </form>
                </div>
            {% endfor %}
        </div>
    {% endif %}
</section>

<section class="content-card task-table-card">
    <div class="section-heading">
        <div>
            <h2>{{ t('projects.tasks') }}</h2>
            <p class="muted">{{ t('projects.tasks_help') }}</p>
        </div>
        <a class="text-link" href="/tasks?project={{ project.id }}">{{ t('projects.open_task_list') }}</a>
    </div>

    {% if tasks is empty %}
        <div class="empty-state">
            <strong>{{ t('projects.no_tasks') }}</strong>
            <span>{{ t('projects.no_tasks_help') }}</span>
        </div>
    {% else %}
        <div class="table-wrap">
            <table class="task-table">
                <thead><tr><th>{{ t('tasks.table.task') }}</th><th>{{ t('tasks.table.status') }}</th><th>{{ t('tasks.table.deadline') }}</th></tr></thead>
                <tbody>
                {% for task in tasks %}
                    <tr>
                        <td><a class="task-title" href="/tasks/{{ task.id }}/edit" data-task-preview="{{ task.id }}">{{ task.title }}</a></td>
                        <td>{{ status_map[task.statusId].name|default('—') }}</td>
                        <td class="nowrap">{{ task.deadline ? task.deadline|date('Y-m-d H:i') : '—' }}</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
</section>
{% endblock %}
