{% extends 'app_layout.twig' %}

{% block title %}{{ t('projects.page_title') }} · TMS{% endblock %}
{% block styles %}<link rel="stylesheet" href="/assets/metadata.css"><link rel="stylesheet" href="/assets/collaboration.css">{% endblock %}

{% block content %}
<header class="page-header compact-page-header">
    <div>
        <h1>{{ t('projects.title') }}</h1>
        <p class="muted">{{ t('projects.subtitle') }}</p>
    </div>
    <button type="button" data-dialog-trigger="#project-create-dialog">{{ t('projects.create') }}</button>
</header>

<section class="content-card metadata-section">
    <div class="section-heading">
        <div>
            <h2>{{ t('projects.yours') }}</h2>
            <p class="muted">{{ t('projects.owner_help') }}</p>
        </div>
    </div>

    {% if projects is empty %}
        <div class="empty-state">
            <strong>{{ t('projects.empty') }}</strong>
            <span>{{ t('projects.empty_help') }}</span>
        </div>
    {% else %}
        <div class="metadata-list collab-project-grid">
        {% for project in projects %}
            <article class="metadata-item collab-project-card">
                <div class="metadata-item-heading">
                    <strong><a class="text-link" href="/projects/{{ project.id }}">{{ project.name }}</a></strong>
                    <div class="metadata-badges">
                        <span class="metadata-badge">{{ t('projects.status.' ~ project.lifecycleStatus) }}</span>
                        {% if project.ownerTeamId %}
                            <span class="metadata-badge">{{ team_map[project.ownerTeamId].name|default('—') }}</span>
                        {% else %}
                            <span class="metadata-badge">{{ t('projects.personal') }}</span>
                        {% endif %}
                    </div>
                </div>
                {% if project.description %}<p class="muted entity-card-description">{{ project.description }}</p>{% endif %}
                <div class="entity-card-actions">
                    <a class="button-link secondary-link compact" href="/projects/{{ project.id }}">{{ t('projects.action_overview') }}</a>
                    {% if manageable_projects[project.id]|default(false) %}
                        <a class="button-link secondary-link compact" href="/projects/{{ project.id }}/settings">{{ t('projects.action_settings') }}</a>
                        <a class="button-link secondary-link compact" href="/projects/{{ project.id }}/statuses">{{ t('projects.action_statuses') }}</a>
                        <a class="button-link secondary-link compact" href="/projects/{{ project.id }}/fields">{{ t('projects.action_fields') }}</a>
                    {% endif %}
                    <a class="button-link secondary-link compact" href="/projects/{{ project.id }}/files">{{ t('projects.action_files') }}</a>
                    {% if project.ownerTeamId %}
                        <a class="button-link secondary-link compact" href="/projects/{{ project.id }}/discussion">{{ t('projects.action_discussion') }}</a>
                    {% endif %}
                </div>
            </article>
        {% endfor %}
        </div>
    {% endif %}
</section>

<dialog class="collaboration-dialog" id="project-create-dialog" data-collaboration-dialog {{ open_create_dialog ? 'data-auto-open' : '' }}>
    <form class="collaboration-dialog-form" method="post" action="/projects">
        <input type="hidden" name="_csrf" value="{{ csrf_token }}">
        <header class="quick-add-dialog-header">
            <div>
                <h2>{{ t('projects.create_title') }}</h2>
                <p class="muted">{{ t('projects.create_help') }}</p>
            </div>
            <button class="secondary compact quick-add-close" type="button" data-dialog-close aria-label="{{ t('common.cancel') }}">×</button>
        </header>
        {% if error %}<p class="alert" role="alert">{{ error }}</p>{% endif %}
        <label>
            <span>{{ t('projects.name') }}</span>
            <input type="text" name="name" maxlength="160" required value="{{ create_form.name|default('') }}" autofocus>
        </label>
        <label>
            <span>{{ t('projects.owner') }}</span>
            {% set owner_scope = create_form.owner_scope|default('personal') %}
            <select name="owner_scope">
                <option value="personal" {{ owner_scope == 'personal' ? 'selected' : '' }}>{{ t('projects.owner_personal') }}</option>
                {% for team in lead_teams %}
                    {% set value = 'team:' ~ team.id %}
                    <option value="{{ value }}" {{ owner_scope == value ? 'selected' : '' }}>{{ t('projects.owner_team', {'team': team.name}) }}</option>
                {% endfor %}
            </select>
        </label>
        <label>
            <span>{{ t('projects.status') }}</span>
            {% set create_status = create_form.lifecycle_status|default('active') %}
            <select name="lifecycle_status">
                {% for status in lifecycle_statuses %}
                    <option value="{{ status }}" {{ create_status == status ? 'selected' : '' }}>{{ t('projects.status.' ~ status) }}</option>
                {% endfor %}
            </select>
        </label>
        <label>
            <span>{{ t('projects.description') }}</span>
            <textarea name="description" rows="5" maxlength="20000" placeholder="{{ t('projects.description_placeholder') }}">{{ create_form.description|default('') }}</textarea>
        </label>
        <footer class="quick-add-dialog-actions">
            <button type="submit">{{ t('projects.create') }}</button>
            <button class="secondary" type="button" data-dialog-close>{{ t('common.cancel') }}</button>
        </footer>
    </form>
</dialog>
{% endblock %}

{% block scripts %}<script src="/assets/collaboration.js" defer></script>{% endblock %}
