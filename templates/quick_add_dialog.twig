<dialog class="quick-add-dialog" id="quick-add-dialog" aria-labelledby="quick-add-title">
    <form class="quick-add-dialog-form" method="post" action="/tasks/quick-add" data-quick-add-form>
        <input type="hidden" name="_csrf" value="{{ csrf_token }}">
        <header class="quick-add-dialog-header">
            <div>
                <h2 id="quick-add-title">{{ t('quick_add.dialog_title') }}</h2>
                <p class="muted">{{ t('quick_add.help') }}</p>
            </div>
            <button class="secondary compact quick-add-close" type="button" data-quick-add-close aria-label="{{ t('common.cancel') }}">×</button>
        </header>

        <label>
            {{ t('task_form.title') }}
            <input type="text" name="title" maxlength="255" required autocomplete="off" placeholder="{{ t('quick_add.title_placeholder') }}" data-quick-add-title-input>
        </label>
        <label>
            {{ t('task_form.deadline') }}
            <input type="datetime-local" name="deadline">
        </label>
        <label>
            {{ t('task_form.description') }}
            <textarea name="description" rows="3" maxlength="10000" placeholder="{{ t('quick_add.description_placeholder') }}"></textarea>
        </label>

        <p class="quick-add-result" data-quick-add-result role="status" aria-live="polite" hidden></p>

        <footer class="quick-add-dialog-actions">
            <button type="submit">{{ t('quick_add.submit') }}</button>
            <a class="button-link secondary-link" href="/tasks/new">{{ t('quick_add.full_form') }}</a>
            <span class="field-help quick-add-shortcut">{{ t('quick_add.shortcut_help') }}</span>
        </footer>
    </form>
</dialog>
