<section class="discussion-panel" id="discussion">
    {% if discussion_notice %}
        <p class="{{ discussion_notice.kind == 'error' ? 'alert discussion-notice' : 'success-notice discussion-notice' }}" role="status">{{ discussion_notice.message }}</p>
    {% endif %}

    <form class="discussion-compose" method="post" action="{{ discussion_base_url }}" data-discussion-form>
        <input type="hidden" name="_csrf" value="{{ csrf_token }}">
        <div class="discussion-composer discussion-editor" data-discussion-editor data-link-prompt="{{ t('discussions.link_prompt') }}">
            <textarea class="discussion-source" name="body" rows="4" maxlength="20000" placeholder="{{ t('discussions.body_placeholder') }}"></textarea>
            <div class="discussion-surface" contenteditable="true" role="textbox" aria-multiline="true"
                 data-placeholder="{{ t('discussions.body_placeholder') }}" hidden></div>
            <div class="discussion-composer-footer">
                {% include 'discussions/_toolbar.twig' %}
                <div class="discussion-compose-actions">
                    <span class="field-help">{{ t('discussions.mention_help') }}</span>
                    <button class="compact" type="submit">{{ t('discussions.post') }}</button>
                </div>
            </div>
        </div>
    </form>

    {% if discussion_comments is empty %}
        <div class="discussion-empty">
            <strong>{{ t('discussions.empty') }}</strong>
            <span class="muted">{{ t('discussions.empty_help') }}</span>
        </div>
    {% else %}
        <div class="discussion-thread">
            {% for comment in discussion_comments %}
                {% if comment.parentCommentId is null %}
                    <article class="discussion-comment discussion-root" id="comment-{{ comment.id }}">
                        <div class="discussion-avatar" aria-hidden="true">
                            {{ comment.authorUsername ? comment.authorUsername|slice(0, 1)|upper : '?' }}
                        </div>
                        <div class="discussion-comment-content">
                            <header class="discussion-comment-meta">
                                <strong>{{ comment.authorUsername|default(t('discussions.deleted_user')) }}</strong>
                                <span class="muted">{{ format_database_datetime(comment.createdAt) }}</span>
                                {% if not comment.isDeleted and comment.updatedAt != comment.createdAt %}
                                    <span class="muted">· {{ t('discussions.edited') }}</span>
                                {% endif %}
                            </header>

                            {% if comment.isDeleted %}
                                <p class="muted discussion-deleted">{{ t('discussions.deleted_placeholder') }}</p>
                            {% else %}
                                <div class="discussion-body">{{ comment.bodyHtml|raw }}</div>
                                <div class="discussion-actions">
                                    <details>
                                        <summary class="text-link">{{ t('discussions.reply') }}</summary>
                                        <form method="post" action="{{ discussion_base_url }}/{{ comment.id }}/reply" data-discussion-form>
                                            <input type="hidden" name="_csrf" value="{{ csrf_token }}">
                                            <div class="discussion-editor compact-editor" data-discussion-editor data-link-prompt="{{ t('discussions.link_prompt') }}">
                                                <textarea class="discussion-source" name="body" rows="3" maxlength="20000" placeholder="{{ t('discussions.body_placeholder') }}"></textarea>
                                                <div class="discussion-surface" contenteditable="true" role="textbox" aria-multiline="true"
                                                     data-placeholder="{{ t('discussions.body_placeholder') }}" hidden></div>
                                                <div class="discussion-composer-footer compact">
                                                    {% include 'discussions/_toolbar.twig' %}
                                                    <button class="compact" type="submit">{{ t('discussions.post_reply') }}</button>
                                                </div>
                                            </div>
                                        </form>
                                    </details>

                                    {% if comment.authorUserId == discussion_current_user_id %}
                                        <details>
                                            <summary class="text-link">{{ t('discussions.edit') }}</summary>
                                            <form method="post" action="{{ discussion_base_url }}/{{ comment.id }}" data-discussion-form>
                                                <input type="hidden" name="_csrf" value="{{ csrf_token }}">
                                                <div class="discussion-editor compact-editor" data-discussion-editor data-link-prompt="{{ t('discussions.link_prompt') }}">
                                                    <textarea class="discussion-source" name="body" rows="3" maxlength="20000">{{ comment.bodyHtml }}</textarea>
                                                    <div class="discussion-surface" contenteditable="true" role="textbox" aria-multiline="true" hidden></div>
                                                    <div class="discussion-composer-footer compact">
                                                        {% include 'discussions/_toolbar.twig' %}
                                                        <button class="compact" type="submit">{{ t('discussions.save_edit') }}</button>
                                                    </div>
                                                </div>
                                            </form>
                                        </details>
                                    {% endif %}

                                    {% if comment.authorUserId == discussion_current_user_id or discussion_can_moderate %}
                                        <form method="post" action="{{ discussion_base_url }}/{{ comment.id }}/delete"
                                              onsubmit="return confirm('{{ t('discussions.delete_confirm')|e('js') }}')">
                                            <input type="hidden" name="_csrf" value="{{ csrf_token }}">
                                            <button class="danger-link compact" type="submit">{{ t('discussions.delete') }}</button>
                                        </form>
                                    {% endif %}
                                </div>
                            {% endif %}

                            <div class="discussion-replies">
                                {% for reply in discussion_comments %}
                                    {% if reply.parentCommentId == comment.id %}
                                        <article class="discussion-comment discussion-reply" id="comment-{{ reply.id }}">
                                            <div class="discussion-avatar small" aria-hidden="true">
                                                {{ reply.authorUsername ? reply.authorUsername|slice(0, 1)|upper : '?' }}
                                            </div>
                                            <div class="discussion-comment-content">
                                                <header class="discussion-comment-meta">
                                                    <strong>{{ reply.authorUsername|default(t('discussions.deleted_user')) }}</strong>
                                                    <span class="muted">{{ format_database_datetime(reply.createdAt) }}</span>
                                                    {% if not reply.isDeleted and reply.updatedAt != reply.createdAt %}
                                                        <span class="muted">· {{ t('discussions.edited') }}</span>
                                                    {% endif %}
                                                </header>
                                                {% if reply.isDeleted %}
                                                    <p class="muted discussion-deleted">{{ t('discussions.deleted_placeholder') }}</p>
                                                {% else %}
                                                    <div class="discussion-body">{{ reply.bodyHtml|raw }}</div>
                                                    <div class="discussion-actions">
                                                        {% if reply.authorUserId == discussion_current_user_id %}
                                                            <details>
                                                                <summary class="text-link">{{ t('discussions.edit') }}</summary>
                                                                <form method="post" action="{{ discussion_base_url }}/{{ reply.id }}" data-discussion-form>
                                                                    <input type="hidden" name="_csrf" value="{{ csrf_token }}">
                                                                    <div class="discussion-editor compact-editor" data-discussion-editor data-link-prompt="{{ t('discussions.link_prompt') }}">
                                                                        <textarea class="discussion-source" name="body" rows="3" maxlength="20000">{{ reply.bodyHtml }}</textarea>
                                                                        <div class="discussion-surface" contenteditable="true" role="textbox" aria-multiline="true" hidden></div>
                                                                        <div class="discussion-composer-footer compact">
                                                                            {% include 'discussions/_toolbar.twig' %}
                                                                            <button class="compact" type="submit">{{ t('discussions.save_edit') }}</button>
                                                                        </div>
                                                                    </div>
                                                                </form>
                                                            </details>
                                                        {% endif %}
                                                        {% if reply.authorUserId == discussion_current_user_id or discussion_can_moderate %}
                                                            <form method="post" action="{{ discussion_base_url }}/{{ reply.id }}/delete"
                                                                  onsubmit="return confirm('{{ t('discussions.delete_confirm')|e('js') }}')">
                                                                <input type="hidden" name="_csrf" value="{{ csrf_token }}">
                                                                <button class="danger-link compact" type="submit">{{ t('discussions.delete') }}</button>
                                                            </form>
                                                        {% endif %}
                                                    </div>
                                                {% endif %}
                                            </div>
                                        </article>
                                    {% endif %}
                                {% endfor %}
                            </div>
                        </div>
                    </article>
                {% endif %}
            {% endfor %}
        </div>
    {% endif %}
</section>
