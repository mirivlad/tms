<div class="discussion-toolbar" role="toolbar" aria-label="{{ t('discussions.toolbar_aria') }}">
    <button type="button" class="secondary compact" data-discussion-command="bold" title="{{ t('task_form.rich_bold') }}"><strong>B</strong></button>
    <button type="button" class="secondary compact" data-discussion-command="italic" title="{{ t('task_form.rich_italic') }}"><em>I</em></button>
    <button type="button" class="secondary compact" data-discussion-command="underline" title="{{ t('task_form.rich_underline') }}"><u>U</u></button>
    <button type="button" class="secondary compact" data-discussion-command="insertUnorderedList" title="{{ t('task_form.rich_bullets') }}">•</button>
    <button type="button" class="secondary compact" data-discussion-command="insertOrderedList" title="{{ t('task_form.rich_numbered') }}">1.</button>
    <button type="button" class="secondary compact" data-discussion-command="formatBlock" data-discussion-value="blockquote" title="{{ t('task_form.rich_quote') }}">❯</button>
    <button type="button" class="secondary compact" data-discussion-command="createLink" title="{{ t('task_form.rich_link') }}">↗</button>
    <button type="button" class="secondary compact" data-discussion-command="unlink" title="{{ t('task_form.rich_unlink') }}">×↗</button>
    <button type="button" class="secondary compact" data-discussion-command="removeFormat" title="{{ t('task_form.rich_clear') }}">×</button>
</div>
