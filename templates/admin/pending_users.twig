{% extends "app_layout.twig" %}
{% block title %}{{ t('admin.pending_users') }} · TMS{% endblock %}
{% block content %}
<div class="page-header"><div><p class="eyebrow">{{ t('admin.eyebrow') }}</p><h1>{{ t('admin.pending_users') }}</h1><p class="muted">{{ t('admin.pending_help') }}</p></div><a class="secondary-link button-link" href="/admin/users">{{ t('admin.users') }}</a></div>
{% if notice %}<div class="{{ notice.kind == 'error' ? 'alert' : 'success-notice' }}">{{ notice.message }}</div>{% endif %}
<section class="content-card task-table-card">{% if users is empty %}<div class="empty-state"><strong>{{ t('admin.no_pending') }}</strong></div>{% else %}<div class="table-wrap"><table class="task-table"><thead><tr><th>{{ t('profile.username') }}</th><th>{{ t('profile.email') }}</th><th>{{ t('admin.email_verified') }}</th><th>{{ t('admin.approved') }}</th><th></th></tr></thead><tbody>{% for user in users %}<tr><td><a class="task-title" href="/admin/users/{{ user.id }}/edit">{{ user.username }}</a></td><td>{{ user.email }}</td><td>{{ user.isEmailVerified ? t('common.yes') : t('common.no') }}</td><td>{{ user.isApproved ? t('common.yes') : t('common.no') }}</td><td class="row-actions">{% if not user.isEmailVerified %}<form method="post" action="/admin/users/{{ user.id }}/verify-email"><input type="hidden" name="_csrf" value="{{ csrf_token }}"><input type="hidden" name="return_to" value="/admin/pending-users"><button class="secondary compact" type="submit">{{ t('admin.verify_email') }}</button></form><form method="post" action="/admin/users/{{ user.id }}/resend-verification"><input type="hidden" name="_csrf" value="{{ csrf_token }}"><input type="hidden" name="return_to" value="/admin/pending-users"><button class="secondary compact" type="submit">{{ t('admin.resend') }}</button></form>{% endif %}{% if not user.isApproved %}<form method="post" action="/admin/users/{{ user.id }}/approve"><input type="hidden" name="_csrf" value="{{ csrf_token }}"><input type="hidden" name="return_to" value="/admin/pending-users"><button type="submit">{{ t('admin.approve') }}</button></form>{% endif %}</td></tr>{% endfor %}</tbody></table></div>{% endif %}</section>
{% endblock %}
