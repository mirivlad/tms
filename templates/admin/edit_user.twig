{% extends "app_layout.twig" %}
{% block title %}{{ t('admin.edit_user') }} · TMS{% endblock %}
{% block content %}
<div class="page-header"><div><p class="eyebrow">{{ t('admin.eyebrow') }}</p><h1>{{ t('admin.edit_user') }}: {{ user.username }}</h1></div><a class="secondary-link button-link" href="/admin/users">{{ t('admin.back') }}</a></div>
{% if notice %}<div class="{{ notice.kind == 'error' ? 'alert' : 'success-notice' }}">{{ notice.message }}</div>{% endif %}
<div class="admin-edit-grid"><section class="content-card"><div class="section-heading"><div><h2>{{ t('admin.account_details') }}</h2></div></div><form method="post" action="/admin/users/{{ user.id }}/edit"><input type="hidden" name="_csrf" value="{{ csrf_token }}"><label>{{ t('profile.username') }}<input type="text" name="username" required minlength="3" maxlength="64" value="{{ user.username }}"></label><label>{{ t('profile.email') }}<input type="email" name="email" required value="{{ user.email }}"></label><label>{{ t('admin.role') }}<select name="role"><option value="user" {{ user.role == 'user' ? 'selected' : '' }}>{{ t('admin.role_user') }}</option><option value="admin" {{ user.role == 'admin' ? 'selected' : '' }}>{{ t('admin.role_admin') }}</option></select></label><label class="checkbox-row"><input type="checkbox" name="is_active" value="1" {{ user.isActive ? 'checked' : '' }}><span>{{ t('admin.active') }}</span></label><button type="submit">{{ t('common.save') }}</button></form></section>
<section class="content-card"><div class="section-heading"><div><h2>{{ t('admin.verification') }}</h2></div></div><dl class="admin-user-facts"><dt>{{ t('admin.email_verified') }}</dt><dd>{{ user.isEmailVerified ? t('common.yes') : t('common.no') }}</dd><dt>{{ t('admin.approved') }}</dt><dd>{{ user.isApproved ? t('common.yes') : t('common.no') }}</dd><dt>{{ t('admin.created') }}</dt><dd>{{ user.createdAt ? user.createdAt|date('Y-m-d H:i') : '—' }}</dd></dl>{% if not user.isEmailVerified %}<form method="post" action="/admin/users/{{ user.id }}/verify-email"><input type="hidden" name="_csrf" value="{{ csrf_token }}"><input type="hidden" name="return_to" value="/admin/users/{{ user.id }}/edit"><button type="submit">{{ t('admin.verify_email') }}</button></form><form method="post" action="/admin/users/{{ user.id }}/resend-verification"><input type="hidden" name="_csrf" value="{{ csrf_token }}"><input type="hidden" name="return_to" value="/admin/users/{{ user.id }}/edit"><button class="secondary" type="submit">{{ t('admin.resend') }}</button></form>{% endif %}{% if not user.isApproved %}<form method="post" action="/admin/users/{{ user.id }}/approve"><input type="hidden" name="_csrf" value="{{ csrf_token }}"><input type="hidden" name="return_to" value="/admin/users/{{ user.id }}/edit"><button type="submit">{{ t('admin.approve') }}</button></form>{% endif %}</section></div>
{% endblock %}
