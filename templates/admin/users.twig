{% extends "app_layout.twig" %}
{% block title %}{{ t('admin.users') }} · TMS{% endblock %}
{% block content %}
<div class="page-header"><div><p class="eyebrow">{{ t('admin.eyebrow') }}</p><h1>{{ t('admin.users') }}</h1><p class="muted">{{ t('admin.users_help') }}</p></div><div class="admin-actions"><a class="secondary-link button-link" href="/admin/pending-users">{{ t('admin.pending_users') }}{% if pending_count %} ({{ pending_count }}){% endif %}</a><a class="secondary-link button-link" href="/admin">{{ t('admin.back') }}</a></div></div>
{% if notice %}<div class="{{ notice.kind == 'error' ? 'alert' : 'success-notice' }}">{{ notice.message }}</div>{% endif %}
<section class="content-card task-table-card"><div class="table-wrap"><table class="task-table admin-user-table"><thead><tr><th>ID</th><th>{{ t('profile.username') }}</th><th>{{ t('profile.email') }}</th><th>{{ t('admin.role') }}</th><th>{{ t('admin.active') }}</th><th>{{ t('admin.email_verified') }}</th><th>{{ t('admin.approved') }}</th><th>{{ t('admin.created') }}</th><th></th></tr></thead><tbody>
{% for user in users %}<tr><td>{{ user.id }}</td><td><strong>{{ user.username }}</strong>{% if user.id == current_user_id %} <span class="metadata-badge">{{ t('admin.you') }}</span>{% endif %}</td><td>{{ user.email }}</td><td>{{ t('admin.role_' ~ user.role) }}</td><td>{{ user.isActive ? t('common.yes') : t('common.no') }}</td><td>{{ user.isEmailVerified ? t('common.yes') : t('common.no') }}</td><td>{{ user.isApproved ? t('common.yes') : t('common.no') }}</td><td class="nowrap">{{ user.createdAt ? user.createdAt|date('Y-m-d H:i') : '—' }}</td><td class="row-actions"><a class="text-link" href="/admin/users/{{ user.id }}/edit">{{ t('common.edit') }}</a>{% if user.id != current_user_id %}<form method="post" action="/admin/users/{{ user.id }}/impersonate"><input type="hidden" name="_csrf" value="{{ csrf_token }}"><button class="danger-link admin-impersonate" type="submit">{{ t('admin.impersonate') }}</button></form><form method="post" action="/admin/users/{{ user.id }}/delete" onsubmit="return confirm('{{ t('admin.delete_confirm') }}')"><input type="hidden" name="_csrf" value="{{ csrf_token }}"><button class="danger-link" type="submit">{{ t('common.delete') }}</button></form>{% endif %}</td></tr>{% endfor %}
</tbody></table></div></section>
{% endblock %}
