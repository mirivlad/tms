{% extends "app_layout.twig" %}
{% block title %}{{ t('admin.users') }} · TMS{% endblock %}
{% block content %}
<div class="page-header compact-page-header"><h1>{{ t('admin.users') }}</h1><div class="admin-actions"><a class="button-link" href="/admin/users/new">{{ t('admin.create_user') }}</a><a class="secondary-link button-link" href="/admin/pending-users">{{ t('admin.pending_users') }}{% if pending_count %} ({{ pending_count }}){% endif %}</a><a class="secondary-link button-link" href="/admin">{{ t('admin.back') }}</a></div></div>
{% if notice %}<div class="{{ notice.kind == 'error' ? 'alert' : 'success-notice' }}">{{ notice.message }}</div>{% endif %}
<section class="content-card task-table-card"><div class="table-wrap"><table class="task-table admin-user-table"><thead><tr><th>ID</th><th>{{ t('profile.username') }}</th><th>{{ t('profile.email') }}</th><th>{{ t('admin.role') }}</th><th>{{ t('admin.active') }}</th><th>{{ t('admin.email_verified') }}</th><th>{{ t('admin.approved') }}</th><th>{{ t('admin.created') }}</th><th>{{ t('admin.last_activity') }}</th><th></th></tr></thead><tbody>
{% for user in users %}<tr><td data-label="ID">{{ user.id }}</td><td class="task-title-cell" data-label="{{ t('profile.username') }}"><strong>{{ user.username }}</strong>{% if user.id == current_user_id %} <span class="metadata-badge">{{ t('admin.you') }}</span>{% endif %}</td><td data-label="{{ t('profile.email') }}">{{ user.email }}</td><td data-label="{{ t('admin.role') }}">{{ t('admin.role_' ~ user.role) }}</td><td data-label="{{ t('admin.active') }}">{{ user.isActive ? t('common.yes') : t('common.no') }}</td><td data-label="{{ t('admin.email_verified') }}">{{ user.isEmailVerified ? t('common.yes') : t('common.no') }}</td><td data-label="{{ t('admin.approved') }}">{{ user.isApproved ? t('common.yes') : t('common.no') }}</td><td class="nowrap" data-label="{{ t('admin.created') }}">{{ user.createdAt ? user.createdAt|date('Y-m-d H:i') : '—' }}</td><td class="nowrap" data-label="{{ t('admin.last_activity') }}">{{ user.lastActivityAt ? format_utc_datetime(user.lastActivityAt, locale == 'ru' ? 'd.m.Y H:i' : 'Y-m-d H:i') : t('admin.no_activity') }}</td><td class="row-actions task-row-actions"><button class="danger-link" type="button" data-admin-user-detail="{{ user.id }}">{{ t('admin.view_details') }}</button><a class="text-link" href="/admin/users/{{ user.id }}/edit">{{ t('common.edit') }}</a>{% if user.id != current_user_id %}<form method="post" action="/admin/users/{{ user.id }}/impersonate"><input type="hidden" name="_csrf" value="{{ csrf_token }}"><button class="danger-link admin-impersonate" type="submit">{{ t('admin.impersonate') }}</button></form><form method="post" action="/admin/users/{{ user.id }}/delete" onsubmit="return confirm('{{ t('admin.delete_confirm') }}')"><input type="hidden" name="_csrf" value="{{ csrf_token }}"><button class="danger-link" type="submit">{{ t('common.delete') }}</button></form>{% endif %}</td></tr>{% endfor %}
</tbody></table></div></section>
{% include "admin/user_detail_dialog.twig" %}
{% endblock %}

{% block scripts %}<script src="/assets/admin-users.js" defer></script>{% endblock %}
