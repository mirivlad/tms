{% extends "app_layout.twig" %}
{% block title %}{{ t('mcp.title') }} · TMS{% endblock %}
{% block content %}
<div class="page-header compact-page-header"><h1>{{ t('mcp.title') }}</h1><a href="/settings/profile">{{ t('profile.title') }}</a></div>
<section class="content-card form-card">
    <p>{{ t('mcp.help') }}</p>
    <p>{{ t('mcp.endpoint') }}: <code>{{ endpoint }}</code></p>
    {% if error %}<div class="alert" role="alert">{{ error }}</div>{% endif %}
    {% if secret %}
        <div class="success-notice"><p>{{ t('mcp.secret_once') }}</p>
        <label>{{ t('mcp.token') }}<input readonly type="text" value="{{ secret }}" autocomplete="off" spellcheck="false"></label></div>
    {% endif %}
    <form method="post" action="/settings/mcp" class="task-form">
        <input type="hidden" name="_csrf" value="{{ csrf_token }}">
        <label>{{ t('mcp.label') }}<input name="label" required maxlength="100" placeholder="Codex"></label>
        <label>{{ t('mcp.scope') }}<select name="scope"><option value="read">{{ t('mcp.read') }}</option><option value="write">{{ t('mcp.write') }}</option><option value="delete">{{ t('mcp.delete') }}</option></select></label>
        <label>{{ t('mcp.days') }}<input name="days" type="number" required min="0" max="365" value="30"></label>
        <label>{{ t('profile.current_password') }}<input name="password" type="password" required autocomplete="current-password"></label>
        <div class="form-actions field-wide"><button type="submit">{{ t('mcp.issue') }}</button></div>
    </form>
</section>
<section class="content-card">
    <h2>{{ t('mcp.tokens') }}</h2>
    <table>
        <thead><tr><th>{{ t('mcp.label') }}</th><th>{{ t('mcp.scope') }}</th><th>{{ t('mcp.expires') }}</th><th>{{ t('mcp.revoked') }}</th><th></th></tr></thead>
        <tbody>{% for token in tokens %}<tr><td>{{ token.label }}</td><td>{{ t(token.can_delete ? 'mcp.delete' : (token.can_write ? 'mcp.write' : 'mcp.read')) }}</td><td>{% if token.expires_at is null %}{{ t('mcp.permanent') }}{% else %}{{ token.expires_at }} UTC{% endif %}</td><td>{{ token.revoked_at ?? '—' }}</td><td>
        {% if not token.revoked_at %}<form method="post" action="/settings/mcp/{{ token.id }}/revoke"><input type="hidden" name="_csrf" value="{{ csrf_token }}"><button type="submit">{{ t('mcp.revoke') }}</button></form>{% endif %}
        </td></tr>{% else %}<tr><td colspan="5">{{ t('mcp.empty') }}</td></tr>{% endfor %}</tbody>
    </table>
</section>
{% endblock %}
