<!doctype html>
<html lang="{{ locale }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ t('registration.page_title') }} · TMS</title>
    <link rel="stylesheet" href="/assets/themes.css">
    <link rel="stylesheet" href="/assets/app.css">
</head>
<body class="auth-page" data-theme="system">
<main class="auth-card">
    <div class="brand">TMS</div>
    <h1>{{ t('registration.title') }}</h1>
    <p class="muted">{{ t('registration.subtitle') }}</p>
    {% if error %}<div class="alert" role="alert">{{ error }}</div>{% endif %}
    <form method="post" action="/register" autocomplete="on">
        <input type="hidden" name="_csrf" value="{{ csrf_token }}">
        <label>{{ t('auth.username') }}<input name="username" type="text" value="{{ username|default('') }}" required minlength="3" maxlength="64" pattern="[A-Za-z0-9_-]+" autocomplete="username"></label>
        <label>{{ t('registration.email') }}<input name="email" type="email" value="{{ email|default('') }}" required autocomplete="email"></label>
        <label>{{ t('auth.password') }}<input name="password" type="password" required minlength="12" autocomplete="new-password"></label>
        <label>{{ t('registration.password_confirm') }}<input name="password_confirm" type="password" required minlength="12" autocomplete="new-password"></label>
        <label class="registration-captcha-field">
            {{ t('registration.captcha') }}
            <span class="registration-captcha-row">
                <img src="/captcha" width="228" height="72" alt="{{ t('registration.captcha_alt') }}" data-registration-captcha title="{{ t('registration.captcha_refresh') }}">
                <input name="captcha_code" type="text" inputmode="numeric" autocomplete="off" required minlength="6" maxlength="6" pattern="[0-9]{6}" aria-describedby="captcha-help">
            </span>
            <span class="field-help" id="captcha-help">{{ t('registration.captcha_help') }} <a class="text-link" href="#" data-registration-captcha-refresh>{{ t('registration.captcha_refresh') }}</a></span>
        </label>
        <button type="submit">{{ t('registration.submit') }}</button>
    </form>
    <p><a class="text-link" href="/login">{{ t('registration.back_to_login') }}</a></p>
</main>
<script src="/assets/register.js" defer></script>
{% include "page_footer.twig" %}
</body>
</html>
