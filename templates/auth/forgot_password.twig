<!doctype html>
<html lang="{{ locale }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ t('recovery.page_title') }} · TMS</title>
    <link rel="stylesheet" href="/assets/app.css">
</head>
<body class="auth-page">
<main class="auth-card">
    <form class="locale-switch auth-locale-switch" method="post" action="/locale" aria-label="{{ t('locale.switch_aria') }}">
        <input type="hidden" name="_csrf" value="{{ csrf_token }}">
        <button class="locale-choice {{ locale == 'ru' ? 'active' : '' }}" type="submit" name="locale" value="ru">RU</button>
        <span aria-hidden="true">/</span>
        <button class="locale-choice {{ locale == 'en' ? 'active' : '' }}" type="submit" name="locale" value="en">EN</button>
    </form>
    <div class="brand">TMS</div>
    <h1>{{ t('recovery.forgot_title') }}</h1>
    <p class="muted">{{ t('recovery.forgot_help') }}</p>
    {% if submitted %}<div class="notice">{{ t('recovery.generic_sent') }}</div>{% endif %}
    <form method="post" action="/forgot-password">
        <input type="hidden" name="_csrf" value="{{ csrf_token }}">
        <label>{{ t('recovery.identifier') }}
            <input name="identifier" type="text" required autocomplete="username">
        </label>
        <button type="submit">{{ t('recovery.request_submit') }}</button>
    </form>
    <p><a class="text-link" href="/login">{{ t('recovery.back_login') }}</a></p>
</main>
</body>
</html>
