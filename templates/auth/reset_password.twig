<!doctype html>
<html lang="{{ locale }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ t('recovery.reset_title') }} · TMS</title>
    <link rel="stylesheet" href="/assets/app.css">
</head>
<body class="auth-page">
<main class="auth-card">
    <div class="brand">TMS</div>
    <h1>{{ t('recovery.reset_title') }}</h1>
    {% if success %}
        <div class="notice">{{ t('recovery.reset_success') }}</div>
        <p><a class="button-link" href="/login">{{ t('recovery.sign_in') }}</a></p>
    {% elseif not valid %}
        <div class="alert" role="alert">{{ error|default(t('recovery.invalid_link')) }}</div>
        <p><a class="text-link" href="/forgot-password">{{ t('recovery.request_again') }}</a></p>
    {% else %}
        {% if username %}<p class="muted">{{ t('recovery.reset_for', {'username': username}) }}</p>{% endif %}
        {% if error %}<div class="alert" role="alert">{{ error }}</div>{% endif %}
        <form method="post" action="/reset-password">
            <input type="hidden" name="_csrf" value="{{ csrf_token }}">
            <input type="hidden" name="token" value="{{ token }}">
            <label>{{ t('recovery.new_password') }}
                <input name="password" type="password" minlength="12" required autocomplete="new-password">
            </label>
            <label>{{ t('recovery.confirm_password') }}
                <input name="password_confirm" type="password" minlength="12" required autocomplete="new-password">
            </label>
            <button type="submit">{{ t('recovery.reset_submit') }}</button>
        </form>
    {% endif %}
</main>
</body>
</html>
