{% extends 'app_layout.twig' %}

{% block title %}{{ t('custom_fields.page_title') }} · TMS{% endblock %}
{% block styles %}<link rel="stylesheet" href="/assets/metadata.css">{% endblock %}

{% block content %}
<header class="page-header">
    <div>
        <p class="eyebrow">{{ t('custom_fields.eyebrow') }}</p>
        <h1>{{ t('custom_fields.title') }}</h1>
        <p class="muted">{{ t('custom_fields.subtitle') }}</p>
    </div>
</header>

<section class="content-card metadata-section">
    {% if error %}<p class="alert" role="alert">{{ error }}</p>{% endif %}

    <form class="metadata-create type-create" method="post" action="/custom-fields">
        <input type="hidden" name="_csrf" value="{{ csrf_token }}">
        <label>
            <span>{{ t('custom_fields.name') }}</span>
            <input type="text" name="name" maxlength="96" required>
        </label>
        <label>
            <span>{{ t('custom_fields.type') }}</span>
            <select name="field_type" required>
                {% for type in field_types %}
                    <option value="{{ type }}">{{ t('custom_fields.type.' ~ type) }}</option>
                {% endfor %}
            </select>
        </label>
        <label>
            <span>{{ t('custom_fields.options') }}</span>
            <textarea name="options" rows="3" placeholder="{{ t('custom_fields.options_placeholder') }}"></textarea>
        </label>
        <label class="checkbox-inline compact-check">
            <input type="checkbox" name="is_required" value="1">
            {{ t('custom_fields.required') }}
        </label>
        <button type="submit">{{ t('custom_fields.add') }}</button>
    </form>
    <p class="field-help">{{ t('custom_fields.options_help') }}</p>
</section>

<section class="content-card metadata-section">
    <div class="section-heading">
        <div>
            <h2>{{ t('custom_fields.configured') }}</h2>
            <p class="muted">{{ t('custom_fields.order_help') }}</p>
        </div>
    </div>

    {% if fields is empty %}
        <div class="empty-state">
            <strong>{{ t('custom_fields.empty') }}</strong>
            <span>{{ t('custom_fields.empty_help') }}</span>
        </div>
    {% else %}
        <div class="metadata-list">
        {% for field in fields %}
            <article class="metadata-item">
                <div class="metadata-item-heading">
                    <strong>{{ field.name }}</strong>
                    <div class="metadata-badges">
                        <span class="metadata-badge">{{ t('custom_fields.type.' ~ field.type) }}</span>
                        {% if field.isRequired %}<span class="metadata-badge">{{ t('custom_fields.required_badge') }}</span>{% endif %}
                    </div>
                </div>

                <form class="metadata-edit type-edit" method="post" action="/custom-fields/{{ field.id }}">
                    <input type="hidden" name="_csrf" value="{{ csrf_token }}">
                    <label>
                        <span>{{ t('custom_fields.name') }}</span>
                        <input type="text" name="name" maxlength="96" value="{{ field.name }}" required>
                    </label>
                    <label>
                        <span>{{ t('custom_fields.type') }}</span>
                        <select name="field_type" required>
                            {% for type in field_types %}
                                <option value="{{ type }}" {{ field.type == type ? 'selected' : '' }}>{{ t('custom_fields.type.' ~ type) }}</option>
                            {% endfor %}
                        </select>
                    </label>
                    <label>
                        <span>{{ t('custom_fields.options') }}</span>
                        <textarea name="options" rows="3">{{ field.options|join('\n') }}</textarea>
                    </label>
                    <label class="checkbox-inline compact-check">
                        <input type="checkbox" name="is_required" value="1" {{ field.isRequired ? 'checked' : '' }}>
                        {{ t('custom_fields.required') }}
                    </label>
                    <button type="submit">{{ t('common.save') }}</button>
                </form>

                <div class="metadata-actions">
                    <form method="post" action="/custom-fields/{{ field.id }}/move">
                        <input type="hidden" name="_csrf" value="{{ csrf_token }}">
                        <input type="hidden" name="direction" value="up">
                        <button class="secondary compact" type="submit" {{ loop.first ? 'disabled' : '' }}>{{ t('common.move_up') }}</button>
                    </form>
                    <form method="post" action="/custom-fields/{{ field.id }}/move">
                        <input type="hidden" name="_csrf" value="{{ csrf_token }}">
                        <input type="hidden" name="direction" value="down">
                        <button class="secondary compact" type="submit" {{ loop.last ? 'disabled' : '' }}>{{ t('common.move_down') }}</button>
                    </form>
                    <form method="post" action="/custom-fields/{{ field.id }}/delete" onsubmit="return confirm('{{ t('custom_fields.delete_confirm') }}')">
                        <input type="hidden" name="_csrf" value="{{ csrf_token }}">
                        <button class="danger-link" type="submit">{{ t('common.delete') }}</button>
                    </form>
                </div>
            </article>
        {% endfor %}
        </div>
    {% endif %}
</section>
{% endblock %}
