{% extends 'app_layout.twig' %}

{% block title %}{{ t('custom_fields.page_title') }} · TMS{% endblock %}
{% block scripts %}<script src="/assets/custom-fields.js" defer></script>{% endblock %}
{% block styles %}<link rel="stylesheet" href="/assets/metadata.css">{% endblock %}

{% block content %}
<header class="page-header compact-page-header">
    <h1>{{ t('custom_fields.title') }}</h1>
</header>

<section class="content-card metadata-section">
    {% if error and not edit_field_id %}<p class="alert" role="alert">{{ error }}</p>{% endif %}

    {% set create_type = create_form.field_type|default('text') %}
    {% set create_options = create_form.options|default('') %}
    <form class="custom-field-editor custom-field-create" method="post" action="/custom-fields" data-custom-field-form>
        <input type="hidden" name="_csrf" value="{{ csrf_token }}">
        <label class="custom-field-name">
            <span>{{ t('custom_fields.name') }}</span>
            <input type="text" name="name" maxlength="96" value="{{ create_form.name|default('') }}" required>
        </label>
        <label class="custom-field-type">
            <span>{{ t('custom_fields.type') }}</span>
            <select name="field_type" required>
                {% for type in field_types %}
                    <option value="{{ type }}" {{ create_type == type ? 'selected' : '' }}>{{ t('custom_fields.type.' ~ type) }}</option>
                {% endfor %}
            </select>
        </label>
        <label class="custom-field-options" data-custom-field-options {{ create_type in ['select', 'checkbox_list'] ? '' : 'hidden' }}>
            <span>{{ t('custom_fields.options') }}</span>
            <textarea name="options" rows="5" placeholder="{{ t('custom_fields.options_placeholder') }}" {{ create_type in ['select', 'checkbox_list'] ? '' : 'disabled' }}>{{ create_options }}</textarea>
            <small class="field-help">{{ t('custom_fields.options_inline_help') }}</small>
        </label>
        <label class="checkbox-inline compact-check custom-field-required">
            <input type="checkbox" name="is_required" value="1" {{ create_form.is_required|default(false) ? 'checked' : '' }}>
            {{ t('custom_fields.required') }}
        </label>
        <button class="custom-field-submit" type="submit">{{ t('custom_fields.add') }}</button>
    </form>
    <p class="field-help">{{ t('custom_fields.options_help') }}</p>
</section>

<section class="content-card metadata-section">
    <div class="section-heading">
        <div>
            <h2>{{ t('custom_fields.configured') }}</h2>
            <p class="muted">{{ t('custom_fields.order_help') }}</p>
        </div>
    </div>

    {% if fields is empty %}
        <div class="empty-state">
            <strong>{{ t('custom_fields.empty') }}</strong>
            <span>{{ t('custom_fields.empty_help') }}</span>
        </div>
    {% else %}
        <div class="metadata-list">
        {% for field in fields %}
            {% set editing = edit_field_id == field.id %}
            {% set edit_values = editing ? edit_form : {} %}
            {% set edit_type = edit_values.field_type|default(field.type) %}
            {% set edit_options = editing ? edit_values.options|default('') : field.options|join('\n') %}
            <article class="metadata-item">
                <div class="metadata-item-heading">
                    <strong>{{ field.name }}</strong>
                    <div class="metadata-badges">
                        <span class="metadata-badge">{{ t('custom_fields.type.' ~ field.type) }}</span>
                        {% if field.isRequired %}<span class="metadata-badge">{{ t('custom_fields.required_badge') }}</span>{% endif %}
                    </div>
                </div>

                {% if editing and error %}<p class="alert custom-field-inline-error" role="alert">{{ error }}</p>{% endif %}
                <form class="custom-field-editor custom-field-edit" method="post" action="/custom-fields/{{ field.id }}" data-custom-field-form>
                    <input type="hidden" name="_csrf" value="{{ csrf_token }}">
                    <label class="custom-field-name">
                        <span>{{ t('custom_fields.name') }}</span>
                        <input type="text" name="name" maxlength="96" value="{{ edit_values.name|default(field.name) }}" required>
                    </label>
                    <label class="custom-field-type">
                        <span>{{ t('custom_fields.type') }}</span>
                        <select name="field_type" required>
                            {% for type in field_types %}
                                <option value="{{ type }}" {{ edit_type == type ? 'selected' : '' }}>{{ t('custom_fields.type.' ~ type) }}</option>
                            {% endfor %}
                        </select>
                    </label>
                    <label class="custom-field-options" data-custom-field-options {{ edit_type in ['select', 'checkbox_list'] ? '' : 'hidden' }}>
                        <span>{{ t('custom_fields.options') }}</span>
                        <textarea name="options" rows="5" placeholder="{{ t('custom_fields.options_placeholder') }}" {{ edit_type in ['select', 'checkbox_list'] ? '' : 'disabled' }}>{{ edit_options }}</textarea>
                        <small class="field-help">{{ t('custom_fields.options_inline_help') }}</small>
                    </label>
                    <label class="checkbox-inline compact-check custom-field-required">
                        <input type="checkbox" name="is_required" value="1" {{ (editing ? edit_values.is_required|default(false) : field.isRequired) ? 'checked' : '' }}>
                        {{ t('custom_fields.required') }}
                    </label>
                    <button class="custom-field-submit" type="submit">{{ t('common.save') }}</button>
                </form>

                <div class="metadata-actions">
                    <form method="post" action="/custom-fields/{{ field.id }}/move">
                        <input type="hidden" name="_csrf" value="{{ csrf_token }}">
                        <input type="hidden" name="direction" value="up">
                        <button class="secondary compact" type="submit" {{ loop.first ? 'disabled' : '' }}>{{ t('common.move_up') }}</button>
                    </form>
                    <form method="post" action="/custom-fields/{{ field.id }}/move">
                        <input type="hidden" name="_csrf" value="{{ csrf_token }}">
                        <input type="hidden" name="direction" value="down">
                        <button class="secondary compact" type="submit" {{ loop.last ? 'disabled' : '' }}>{{ t('common.move_down') }}</button>
                    </form>
                    <form method="post" action="/custom-fields/{{ field.id }}/delete" onsubmit="return confirm('{{ t('custom_fields.delete_confirm') }}')">
                        <input type="hidden" name="_csrf" value="{{ csrf_token }}">
                        <button class="danger-link" type="submit">{{ t('common.delete') }}</button>
                    </form>
                </div>
            </article>
        {% endfor %}
        </div>
    {% endif %}
</section>
{% endblock %}
