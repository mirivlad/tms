<dialog class="quick-add-dialog task-preview-dialog" id="task-preview-dialog" aria-labelledby="task-preview-title"
    data-label-loading="{{ t('task_preview.loading') }}"
    data-label-failed="{{ t('task_preview.failed') }}"
    data-label-no-description="{{ t('task_preview.no_description') }}"
    data-label-status="{{ t('tasks.status') }}"
    data-label-type="{{ t('tasks.type') }}"
    data-label-priority="{{ t('tasks.priority') }}"
    data-label-customer="{{ t('tasks.customer') }}"
    data-label-project="{{ t('projects.task_project') }}"
    data-label-assignee="{{ t('task_form.assignee') }}"
    data-label-scheduled-at="{{ t('task_form.scheduled_at') }}"
    data-label-deadline="{{ t('task_form.deadline') }}"
    data-label-created="{{ t('task_preview.created') }}"
    data-label-updated="{{ t('task_preview.updated') }}"
    data-label-delete-confirm="{{ t('task_preview.delete_confirm') }}"
    data-label-saved="{{ t('task_preview.saved') }}">
    <div class="task-preview-body">
        <header class="quick-add-dialog-header task-preview-header">
            <div>
                <span class="dialog-kicker">{{ t('task_preview.title') }}</span>
                <div class="task-preview-title-row"><h2 id="task-preview-title" data-task-preview-title></h2><span class="task-preview-id" data-task-preview-meta></span></div>
            </div>
            <button class="secondary compact quick-add-close" type="button" data-task-preview-close aria-label="{{ t('common.close') }}">×</button>
        </header>
        <form class="task-preview-quick-edit" method="post" action="/api/tasks/0/quick-edit" data-task-preview-quick-edit hidden>
            <input type="hidden" name="_csrf" value="{{ csrf_token }}">
            <div class="task-preview-edit-grid">
                <label>
                    <span>{{ t('task_form.status') }}</span>
                    <select name="status_id" data-task-preview-status required></select>
                </label>
                <label>
                    <span>{{ t('task_form.scheduled_at') }}</span>
                    <input type="datetime-local" name="scheduled_at" data-task-preview-scheduled-at>
                </label>
                <label>
                    <span>{{ t('task_form.deadline') }}</span>
                    <input type="datetime-local" name="deadline" data-task-preview-deadline>
                </label>
            </div>
            <div class="task-preview-description-field">
                <span class="task-preview-edit-label">{{ t('task_form.description') }}</span>
                <div class="task-preview-description task-preview-description-editor"
                     data-task-preview-description
                     contenteditable="true"
                     role="textbox"
                     aria-multiline="true"
                     data-placeholder="{{ t('task_form.description_placeholder') }}"></div>
            </div>
            <div class="task-preview-save-row">
                <button type="submit">{{ t('task_preview.save_changes') }}</button>
                <span class="quick-add-result" data-task-preview-save-result role="status" hidden></span>
            </div>
        </form>
        <div class="task-preview-details" data-task-preview-details></div>
        <div class="task-preview-custom" data-task-preview-custom hidden>
            <h3>{{ t('task_preview.custom_fields') }}</h3>
            <dl data-task-preview-custom-list></dl>
        </div>
        <div class="task-preview-attachments" data-task-preview-attachments hidden>
            <h3>{{ t('task_preview.attachments') }}</h3>
            <ul data-task-preview-attachment-list></ul>
        </div>
        <p class="quick-add-result error" data-task-preview-error role="alert" hidden></p>
        <footer class="quick-add-dialog-actions task-preview-actions">
            <form method="post" action="/tasks" data-task-preview-delete-form hidden>
                <input type="hidden" name="_csrf" value="{{ csrf_token }}">
                <button class="danger-button" type="submit">{{ t('task_preview.delete') }}</button>
            </form>
            <div class="task-preview-actions-main">
                <a class="button-link secondary-link task-preview-discussion" href="/tasks" data-task-preview-discussion hidden>
                    {{ t('discussions.open') }}
                    <span class="count-badge" data-task-preview-discussion-count>0</span>
                    <span class="task-preview-unread" data-task-preview-discussion-unread hidden></span>
                </a>
                <a class="button-link" href="/tasks" data-task-preview-edit>{{ t('common.edit') }}</a>
                <button class="secondary" type="button" data-task-preview-close>{{ t('common.close') }}</button>
            </div>
        </footer>
    </div>
</dialog>
