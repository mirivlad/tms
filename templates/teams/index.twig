{% extends 'app_layout.twig' %}

{% block title %}{{ t('teams.page_title') }} · TMS{% endblock %}
{% block styles %}<link rel="stylesheet" href="/assets/metadata.css">{% endblock %}

{% block content %}
<header class="page-header compact-page-header">
    <div>
        <h1>{{ t('teams.title') }}</h1>
        <p class="muted">{{ t('teams.subtitle') }}</p>
    </div>
</header>

{% if notice %}
    <p class="{{ notice.kind == 'error' ? 'alert' : 'success-notice' }}" role="status">{{ notice.message }}</p>
{% endif %}

<section class="content-card metadata-section">
    <div class="section-heading">
        <div>
            <h2>{{ t('teams.create_title') }}</h2>
            <p class="muted">{{ t('teams.create_help') }}</p>
        </div>
    </div>

    <form class="metadata-create" method="post" action="/teams">
        <input type="hidden" name="_csrf" value="{{ csrf_token }}">
        <label>
            <span>{{ t('teams.name') }}</span>
            <input type="text" name="name" maxlength="160" required>
        </label>
        <label class="field-wide">
            <span>{{ t('teams.description') }}</span>
            <textarea name="description" rows="4" maxlength="20000"></textarea>
        </label>
        <button type="submit">{{ t('teams.create') }}</button>
    </form>
</section>

<section class="content-card metadata-section">
    <div class="section-heading">
        <div>
            <h2>{{ t('teams.yours') }}</h2>
            <p class="muted">{{ t('teams.yours_help') }}</p>
        </div>
    </div>

    {% if teams is empty %}
        <div class="empty-state">
            <strong>{{ t('teams.empty') }}</strong>
            <span>{{ t('teams.empty_help') }}</span>
        </div>
    {% else %}
        <div class="metadata-list">
            {% for team in teams %}
                <article class="metadata-item">
                    <div class="metadata-item-heading">
                        <strong><a class="text-link" href="/teams/{{ team.id }}">{{ team.name }}</a></strong>
                        <div class="metadata-badges">
                            <span class="metadata-badge">{{ t('teams.role.' ~ team.currentUserRole) }}</span>
                        </div>
                    </div>
                    {% if team.description %}<p class="muted">{{ team.description }}</p>{% endif %}
                </article>
            {% endfor %}
        </div>
    {% endif %}
</section>
{% endblock %}
