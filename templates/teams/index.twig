{% extends 'app_layout.twig' %}
{% block title %}{{ t('teams.page_title') }} · TMS{% endblock %}
{% block styles %}<link rel="stylesheet" href="/assets/metadata.css"><link rel="stylesheet" href="/assets/collaboration.css">{% endblock %}
{% block content %}
<header class="page-header compact-page-header">
    <div>
        <h1>{{ t('teams.title') }}</h1>
        <p class="muted">{{ t('teams.subtitle') }}</p>
    </div>
    <button type="button" data-dialog-trigger="#team-create-dialog">{{ t('teams.create') }}</button>
</header>

{% if notice %}<p class="{{ notice.kind == 'error' ? 'alert' : 'success-notice' }}" role="status">{{ notice.message }}</p>{% endif %}

<section class="content-card metadata-section">
    <div class="section-heading"><div><h2>{{ t('teams.yours') }}</h2><p class="muted">{{ t('teams.yours_help') }}</p></div></div>
    {% if teams is empty %}
        <div class="empty-state"><strong>{{ t('teams.empty') }}</strong><span>{{ t('teams.empty_help') }}</span></div>
    {% else %}
        <div class="metadata-list collab-team-grid">
        {% for team in teams %}
            <article class="metadata-item collab-team-card">
                <div class="metadata-item-heading">
                    <strong><a class="text-link" href="/teams/{{ team.id }}">{{ team.name }}</a></strong>
                    <div class="metadata-badges"><span class="metadata-badge">{{ t('teams.role.' ~ team.currentUserRole) }}</span></div>
                </div>
                {% if team.description %}<p class="muted entity-card-description">{{ team.description }}</p>{% endif %}
                <div class="entity-card-actions">
                    <a class="button-link secondary-link compact" href="/teams/{{ team.id }}">{{ t('teams.action_overview') }}</a>
                    {% if team.currentUserRole == 'lead' %}<a class="button-link secondary-link compact" href="/teams/{{ team.id }}/settings">{{ t('teams.action_settings') }}</a>{% endif %}
                    <a class="button-link secondary-link compact" href="/teams/{{ team.id }}/members">{{ t('teams.action_members') }}</a>
                </div>
            </article>
        {% endfor %}
        </div>
    {% endif %}
</section>

<dialog class="collaboration-dialog" id="team-create-dialog" data-collaboration-dialog {{ open_create_dialog ? 'data-auto-open' : '' }}>
    <form class="collaboration-dialog-form" method="post" action="/teams">
        <input type="hidden" name="_csrf" value="{{ csrf_token }}">
        <header class="quick-add-dialog-header">
            <div><h2>{{ t('teams.create_title') }}</h2><p class="muted">{{ t('teams.create_help') }}</p></div>
            <button class="secondary compact quick-add-close" type="button" data-dialog-close aria-label="{{ t('common.cancel') }}">×</button>
        </header>
        {% if error %}<p class="alert" role="alert">{{ error }}</p>{% endif %}
        <label><span>{{ t('teams.name') }}</span><input type="text" name="name" maxlength="160" required value="{{ create_form.name|default('') }}" autofocus></label>
        <label><span>{{ t('teams.description') }}</span><textarea name="description" rows="5" maxlength="20000">{{ create_form.description|default('') }}</textarea></label>
        <footer class="quick-add-dialog-actions">
            <button type="submit">{{ t('teams.create') }}</button>
            <button class="secondary" type="button" data-dialog-close>{{ t('common.cancel') }}</button>
        </footer>
    </form>
</dialog>
{% endblock %}
{% block scripts %}<script src="/assets/collaboration.js" defer></script>{% endblock %}
