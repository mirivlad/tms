{% extends 'app_layout.twig' %}
{% block title %}{{ t('teams.action_settings') }} · {{ team.name }} · TMS{% endblock %}
{% block styles %}<link rel="stylesheet" href="/assets/metadata.css"><link rel="stylesheet" href="/assets/collaboration.css">{% endblock %}
{% set team_section = 'settings' %}
{% block content %}
{% include 'teams/_nav.twig' %}
{% if notice %}<p class="{{ notice.kind == 'error' ? 'alert' : 'success-notice' }}" role="status">{{ notice.message }}</p>{% endif %}
<section class="content-card metadata-section entity-management-page">
    <div class="section-heading"><div><h2>{{ t('teams.settings_title') }}</h2><p class="muted">{{ t('teams.settings_help') }}</p></div></div>
    <form class="entity-settings-form" method="post" action="/teams/{{ team.id }}">
        <input type="hidden" name="_csrf" value="{{ csrf_token }}">
        <label><span>{{ t('teams.name') }}</span><input type="text" name="name" maxlength="160" value="{{ team.name }}" required></label>
        <label class="field-wide"><span>{{ t('teams.description') }}</span><textarea name="description" rows="7" maxlength="20000">{{ team.description }}</textarea></label>
        <div class="field-wide"><button type="submit">{{ t('common.save') }}</button></div>
    </form>
</section>
<section class="content-card danger-zone">
    <div><h2>{{ t('teams.delete_title') }}</h2><p class="muted">{{ t('teams.delete_help') }}</p></div>
    <form method="post" action="/teams/{{ team.id }}/delete" onsubmit="return confirm('{{ t('teams.delete_confirm')|e('js') }}')">
        <input type="hidden" name="_csrf" value="{{ csrf_token }}">
        <button class="danger-button" type="submit">{{ t('teams.delete') }}</button>
    </form>
</section>
{% endblock %}
