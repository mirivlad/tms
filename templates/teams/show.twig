{% extends 'app_layout.twig' %}
{% block title %}{{ team.name }} · TMS{% endblock %}
{% block styles %}<link rel="stylesheet" href="/assets/metadata.css"><link rel="stylesheet" href="/assets/collaboration.css">{% endblock %}
{% set team_section = 'overview' %}
{% block content %}
{% include 'teams/_nav.twig' %}
{% if notice %}<p class="{{ notice.kind == 'error' ? 'alert' : 'success-notice' }}" role="status">{{ notice.message }}</p>{% endif %}

<div class="entity-overview-grid">
    <section class="content-card overview-span-2">
        <div class="section-heading"><div><h2>{{ t('teams.overview_about') }}</h2></div></div>
        {% if team.description %}<p>{{ team.description|nl2br }}</p>{% else %}<p class="muted">{{ t('teams.overview_no_description') }}</p>{% endif %}
        <div class="overview-facts">
            <div><span>{{ t('teams.overview_projects') }}</span><strong>{{ project_count }}</strong></div>
            <div><span>{{ t('teams.overview_members') }}</span><strong>{{ member_count }}</strong></div>
            <div><span>{{ t('teams.overview_leads') }}</span><strong>{{ lead_count }}</strong></div>
            <div><span>{{ t('teams.overview_tasks') }}</span><strong>{{ task_count }}</strong></div>
        </div>
    </section>

    <section class="content-card">
        <div class="section-heading">
            <div><h2>{{ t('teams.projects') }}</h2><p class="muted">{{ t('teams.overview_project_load') }}</p></div>
            {% if is_lead %}<a href="/projects?owner=team:{{ team.id }}">{{ t('teams.create_project') }}</a>{% endif %}
        </div>
        <div class="overview-metrics">
            <div><strong>{{ project_count }}</strong><span>{{ t('teams.overview_projects') }}</span></div>
            <div><strong>{{ open_task_count }}</strong><span>{{ t('teams.overview_open_tasks') }}</span></div>
        </div>
        {% if project_summaries is empty %}
            <p class="muted">{{ t('teams.projects_empty') }}</p>
        {% else %}
            <div class="team-project-overview-list">
            {% for item in project_summaries %}
                <a href="/projects/{{ item.project.id }}">
                    <span>
                        <strong>{{ item.project.name }}</strong>
                        <small class="muted">{{ t('projects.status.' ~ item.project.lifecycleStatus) }}</small>
                    </span>
                    <span class="team-project-load">{{ item.open_task_count }} / {{ item.task_count }}</span>
                </a>
            {% endfor %}
            </div>
        {% endif %}
    </section>

    <section class="content-card">
        <div class="section-heading">
            <div><h2>{{ t('teams.members') }}</h2><p class="muted">{{ t('teams.overview_members_help') }}</p></div>
            <a href="/teams/{{ team.id }}/members">{{ t('teams.action_members') }}</a>
        </div>
        <div class="member-preview-grid">
            {% for member in member_preview %}
                <article>
                    <strong>{{ member.username }}</strong>
                    <span class="metadata-badge">{{ t('teams.role.' ~ member.role) }}</span>
                </article>
            {% endfor %}
        </div>
    </section>
</div>
{% endblock %}
