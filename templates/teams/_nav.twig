<header class="page-header compact-page-header">
    <div>
        <h1>{{ team.name }}</h1>
        <p class="muted">{{ t('teams.role.' ~ team.currentUserRole) }}</p>
    </div>
    <a class="text-link" href="/teams">{{ t('teams.back') }}</a>
</header>

<nav class="entity-subnav" aria-label="{{ t('teams.team_navigation') }}">
    <a href="/teams/{{ team.id }}" {{ team_section == 'overview' ? 'class="active"' : '' }}>{{ t('teams.action_overview') }}</a>
    {% if is_lead %}
        <a href="/teams/{{ team.id }}/settings" {{ team_section == 'settings' ? 'class="active"' : '' }}>{{ t('teams.action_settings') }}</a>
    {% endif %}
    <a href="/teams/{{ team.id }}/members" {{ team_section == 'members' ? 'class="active"' : '' }}>{{ t('teams.action_members') }}</a>
</nav>
