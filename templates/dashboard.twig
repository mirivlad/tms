{% extends "app_layout.twig" %}

{% block title %}{{ t('dashboard.page_title') }} · TMS{% endblock %}

{% block content %}
<section class="stats-grid dashboard-stats" aria-label="{{ t('dashboard.stats_aria') }}">
    <a class="stat-card stat-card-current" href="/tasks">
        <span class="stat-value">{{ open_tasks }}</span>
        <span class="stat-label">{{ tp('dashboard.current', open_tasks) }}</span>
    </a>
    <a class="stat-card stat-card-today" href="/tasks?deadline_from={{ today_date }}&deadline_to={{ today_date }}">
        <span class="stat-value">{{ today_tasks }}</span>
        <span class="stat-label">{{ t('dashboard.today') }}</span>
    </a>
    <a class="stat-card stat-card-week" href="/tasks?deadline_from={{ tomorrow_date }}&deadline_to={{ week_end_date }}">
        <span class="stat-value">{{ week_tasks }}</span>
        <span class="stat-label">{{ t('dashboard.week') }}</span>
    </a>
    <a class="stat-card stat-card-overdue" href="/tasks?overdue=1">
        <span class="stat-value">{{ overdue_tasks }}</span>
        <span class="stat-label">{{ tp('dashboard.overdue', overdue_tasks) }}</span>
    </a>
    <a class="stat-card stat-card-urgent" href="/tasks?priority=urgent">
        <span class="stat-value">{{ urgent_tasks }}</span>
        <span class="stat-label">{{ tp('dashboard.urgent', urgent_tasks) }}</span>
    </a>
</section>

{% if tip %}
<section class="content-card dashboard-tip"><strong>{{ t('dashboard.tip_title') }}</strong><p>{{ tip }}</p></section>
{% endif %}

<div class="dashboard-grid">
    <section class="content-card dashboard-status-card">
        <div class="section-heading">
            <div>
                <h2>{{ t('dashboard.by_status') }}</h2>
            </div>
        </div>
        {% if status_breakdown is empty %}
            <div class="empty-state dashboard-empty">
                <span>{{ t('dashboard.no_active_tasks') }}</span>
            </div>
        {% else %}
            <div class="status-chart-wrap">
                <div class="status-donut" style="--status-gradient: {{ status_chart_gradient }}" aria-hidden="true">
                    <span>{{ open_tasks }}</span>
                </div>
                <div class="status-legend">
                    {% for item in status_breakdown %}
                        <a href="/tasks?status_id={{ item.id }}">
                            <span class="status-dot" style="--status-color: {{ item.color }}"></span>
                            <span>{{ item.name }}</span>
                            <strong>{{ item.count }}</strong>
                        </a>
                    {% endfor %}
                </div>
            </div>
        {% endif %}
    </section>

    <section class="content-card dashboard-stuck-card">
        <div class="section-heading">
            <div>
                <h2>{{ t('dashboard.stuck_tasks') }}</h2>
            </div>
            <a href="/tasks">{{ t('common.view_all') }}</a>
        </div>
        {% if stuck_tasks is empty %}
            <div class="empty-state dashboard-empty">
                <span>{{ t('dashboard.no_stuck_tasks') }}</span>
            </div>
        {% else %}
            <div class="task-list compact-list">
                {% for task in stuck_tasks %}
                    <a class="task-row" href="/tasks/{{ task.id }}/edit" data-task-preview="{{ task.id }}">
                        <span class="status-dot" style="--status-color: {{ status_map[task.statusId].color|default('var(--status-neutral)') }}"></span>
                        <span class="task-row-main">
                            <strong>{{ task.title }}</strong>
                            <span class="muted">{{ status_map[task.statusId].name|default(t('task.no_status')) }}</span>
                        </span>
                        <span class="task-deadline">{{ t('dashboard.updated') }} {{ format_database_datetime(task.updatedAt, 'Y-m-d') }}</span>
                    </a>
                {% endfor %}
            </div>
        {% endif %}
    </section>

    <section class="content-card dashboard-next-card">
        <div class="section-heading">
            <div>
                <h2>{{ t('dashboard.next_tasks') }}</h2>
            </div>
            <a href="/tasks">{{ t('common.view_all') }}</a>
        </div>

        {% if next_tasks is empty %}
            <div class="empty-state dashboard-empty">
                <strong>{{ t('dashboard.empty_title') }}</strong>
                <span>{{ t('dashboard.empty_body') }}</span>
            </div>
        {% else %}
            <div class="task-list compact-list">
                {% for task in next_tasks %}
                    <a class="task-row" href="/tasks/{{ task.id }}/edit" data-task-preview="{{ task.id }}">
                        <span class="status-dot" style="--status-color: {{ status_map[task.statusId].color|default('var(--status-neutral)') }}"></span>
                        <span class="task-row-main">
                            <strong>{{ task.title }}</strong>
                            <span class="muted">
                                {{ status_map[task.statusId].name|default(t('task.no_status')) }} · {{ priority_labels[task.priority]|default(t('priority.medium')) }}
                            </span>
                        </span>
                        <span class="task-deadline">{{ task.deadline ? task.deadline|date('Y-m-d H:i') : t('task.no_deadline') }}</span>
                    </a>
                {% endfor %}
            </div>
        {% endif %}
    </section>
</div>

<div class="dashboard-context-grid">
    <section class="content-card dashboard-context-card">
        <div class="section-heading">
            <div>
                <h2>{{ t('dashboard.projects_title') }}</h2>
                <p class="muted">{{ t('dashboard.projects_help') }}</p>
            </div>
            <a href="/projects">{{ t('common.view_all') }}</a>
        </div>
        <div class="dashboard-context-stats">
            <span><strong>{{ projects_count }}</strong> {{ tp('dashboard.projects_total', projects_count) }}</span>
            <span><strong>{{ open_project_tasks }}</strong> {{ tp('dashboard.project_open_tasks', open_project_tasks) }}</span>
            <span><strong>{{ open_unassigned_tasks }}</strong> {{ tp('dashboard.unassigned_open_tasks', open_unassigned_tasks) }}</span>
        </div>
        {% if project_summaries is empty %}
            <div class="empty-state dashboard-empty"><span>{{ t('dashboard.no_projects_context') }}</span></div>
        {% else %}
            <div class="dashboard-context-list">
                {% for project in project_summaries %}
                    <a href="/projects/{{ project.id }}">
                        <span class="dashboard-context-main">
                            <strong>{{ project.name }}</strong>
                            <span class="muted">
                                {{ t('projects.status.' ~ project.lifecycle_status) }}
                                · {{ project.team_name ? project.team_name : t('projects.personal') }}
                            </span>
                        </span>
                        <span class="count-badge">{{ project.open_tasks }}</span>
                    </a>
                {% endfor %}
            </div>
        {% endif %}
    </section>

    <section class="content-card dashboard-context-card">
        <div class="section-heading">
            <div>
                <h2>{{ t('dashboard.teams_title') }}</h2>
                <p class="muted">{{ t('dashboard.teams_help') }}</p>
            </div>
            <a href="/teams">{{ t('common.view_all') }}</a>
        </div>
        <div class="dashboard-context-stats">
            <span><strong>{{ teams_count }}</strong> {{ tp('dashboard.teams_total', teams_count) }}</span>
        </div>
        {% if team_summaries is empty %}
            <div class="empty-state dashboard-empty"><span>{{ t('dashboard.no_teams_context') }}</span></div>
        {% else %}
            <div class="dashboard-context-list">
                {% for team in team_summaries %}
                    <a href="/teams/{{ team.id }}">
                        <span class="dashboard-context-main">
                            <strong>{{ team.name }}</strong>
                            <span class="muted">
                                {{ tp('dashboard.team_projects_count', team.projects) }}
                                · {{ tp('dashboard.team_open_tasks_count', team.open_tasks) }}
                            </span>
                        </span>
                    </a>
                {% endfor %}
            </div>
        {% endif %}
    </section>
</div>
{% endblock %}
