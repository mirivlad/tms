<!doctype html>
<html lang="{{ locale }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}TMS{% endblock %}</title>
    <link rel="stylesheet" href="/assets/themes.css">
    <link rel="stylesheet" href="/assets/app.css">
    <link rel="stylesheet" href="/assets/navigation.css">
    <link rel="stylesheet" href="/assets/custom-fields.css">
    {% block styles %}{% endblock %}
    <link rel="stylesheet" href="/assets/layout-v2.css">
</head>
<body data-theme="{{ current_theme() }}">
<header class="topbar">
    <a class="brand" href="/dashboard">TMS</a>
    <nav class="main-nav" aria-label="{{ t('nav.main_aria') }}">
        <a href="/dashboard" data-nav-path="/dashboard">{{ t('nav.overview') }}</a>
        <a href="/tasks" data-nav-path="/tasks">{{ t('nav.tasks') }}</a>
        <a href="/board" data-nav-path="/board">{{ t('nav.board') }}</a>
        <a class="nav-mobile-secondary" href="/calendar" data-nav-path="/calendar">{{ t('nav.calendar') }}</a>
        <a class="nav-mobile-secondary" href="/projects" data-nav-path="/projects">{{ t('nav.projects') }}</a>
        <a class="nav-mobile-secondary" href="/teams" data-nav-path="/teams">{{ t('nav.teams') }}</a>
    </nav>
    <div class="topbar-actions">
        {% set notification_count = current_notification_count() %}
        {% set team_invitation_count = current_team_invitation_count() %}
        <a class="nav-create-task" href="/tasks/new" data-quick-add-trigger aria-label="{{ t('nav.new_task') }}"><span class="nav-create-task-icon" aria-hidden="true">+</span><span class="nav-create-task-label">{{ t('nav.new_task') }}</span></a>
        <details class="nav-dropdown user-menu" data-nav-menu data-notification-beacon>
            <summary title="{{ t('nav.user_menu') }}" data-alert-summary>
                <span class="user-menu-name">{{ username }}</span>
                {% if notification_count > 0 or team_invitation_count > 0 %}
                    <span class="user-menu-badges" aria-hidden="true" data-alert-summary-badges>
                        {% if notification_count > 0 %}<span class="nav-badge nav-badge-notifications" data-alert-count="notifications">{{ notification_count }}</span>{% endif %}
                        {% if team_invitation_count > 0 %}<span class="nav-badge nav-badge-invitations" data-alert-count="invitations">{{ team_invitation_count }}</span>{% endif %}
                    </span>
                {% endif %}
                <span class="nav-dropdown-chevron" aria-hidden="true">▾</span>
            </summary>
            <div class="nav-dropdown-panel">
                <a class="mobile-menu-only" href="/calendar" data-nav-path="/calendar">{{ t('nav.calendar') }}</a>
                <a class="mobile-menu-only" href="/projects" data-nav-path="/projects">{{ t('nav.projects') }}</a>
                <a class="mobile-menu-only" href="/teams" data-nav-path="/teams">{{ t('nav.teams') }}</a>
                <div class="nav-dropdown-separator mobile-menu-only" aria-hidden="true"></div>
                <a class="user-menu-alert-link" href="/notifications" data-nav-path="/notifications" data-alert-kind="notifications" data-alert-label="{{ t('nav.notifications') }}">
                    <span>{{ t('nav.notifications') }}</span>
                    {% if notification_count > 0 %}<span class="nav-badge nav-badge-notifications" data-alert-count="notifications" aria-label="{{ t('nav.notifications') }}: {{ notification_count }}">{{ notification_count }}</span>{% endif %}
                </a>
                <a class="user-menu-alert-link" href="/invitations" data-nav-path="/invitations" data-alert-kind="invitations" data-alert-label="{{ t('nav.team_invitations') }}">
                    <span>{{ t('nav.team_invitations') }}</span>
                    {% if team_invitation_count > 0 %}<span class="nav-badge nav-badge-invitations" data-alert-count="invitations" aria-label="{{ t('nav.team_invitations') }}: {{ team_invitation_count }}">{{ team_invitation_count }}</span>{% endif %}
                </a>
                <div class="nav-dropdown-separator" aria-hidden="true"></div>
                <details class="nav-submenu user-settings-menu">
                    <summary>{{ t('nav.settings') }} <span class="nav-dropdown-chevron" aria-hidden="true">▾</span></summary>
                    <div class="nav-submenu-panel">
                        <a href="/metadata" data-nav-path="/metadata">{{ t('nav.metadata') }}</a>
                        <a href="/custom-fields" data-nav-path="/custom-fields">{{ t('nav.custom_fields') }}</a>
                        <a href="/settings/notifications" data-nav-path="/settings/notifications">{{ t('nav.notification_settings') }}</a>
                    </div>
                </details>
                <div class="nav-dropdown-separator" aria-hidden="true"></div>
                <a href="/settings/profile" data-nav-path="/settings/profile">{{ t('nav.profile') }}</a>
                {% if current_role() == 'admin' %}<a href="/admin" data-nav-path="/admin">{{ t('admin.title') }}</a>{% endif %}
                <div class="nav-dropdown-separator" aria-hidden="true"></div>
                <form class="dropdown-locale-switch" method="post" action="/locale" aria-label="{{ t('locale.switch_aria') }}">
                    <input type="hidden" name="_csrf" value="{{ csrf_token }}">
                    <span class="dropdown-locale-label">{{ t('locale.switch_aria') }}</span>
                    <div class="dropdown-locale-choices">
                        <button class="locale-choice {{ locale == 'ru' ? 'active' : '' }}" type="submit" name="locale" value="ru" title="{{ t('locale.ru') }}">RU</button>
                        <button class="locale-choice {{ locale == 'en' ? 'active' : '' }}" type="submit" name="locale" value="en" title="{{ t('locale.en') }}">EN</button>
                    </div>
                </form>
                <div class="nav-dropdown-separator" aria-hidden="true"></div>
                <form method="post" action="/logout">
                    <input type="hidden" name="_csrf" value="{{ csrf_token }}">
                    <button class="nav-dropdown-action" type="submit">{{ t('nav.sign_out') }}</button>
                </form>
            </div>
        </details>
    </div>
</header>
{% if is_impersonating() %}<div class="impersonation-bar"><span>{{ t('admin.impersonating', {'username': username}) }}</span><form method="post" action="/admin/stop-impersonation"><input type="hidden" name="_csrf" value="{{ csrf_token }}"><button class="secondary compact" type="submit">{{ t('admin.stop_impersonation') }}</button></form></div>{% endif %}
{% include "quick_add_dialog.twig" %}
{% include "task_preview_dialog.twig" %}
<main class="page">{% block content %}{% endblock %}</main>
<script src="/assets/nav-state.js" defer></script>
<script src="/assets/notification-beacon.js" defer></script>
<script src="/assets/action-icons.js" defer></script>
<script src="/assets/customer-autocomplete.js" defer></script>
<script src="/assets/money-input.js" defer></script>
<script src="/assets/quick-add.js" defer></script>
<script src="/assets/task-preview.js" defer></script>
{% block scripts %}{% endblock %}
{% include "page_footer.twig" %}
</body>
</html>
