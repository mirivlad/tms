{% extends "app_layout.twig" %}
{% block title %}{{ t('notifications.admin_title') }} · TMS{% endblock %}
{% block styles %}<link rel="stylesheet" href="/assets/notifications.css">{% endblock %}
{% block content %}
<div class="page-header"><div><p class="eyebrow">{{ t('notifications.admin_eyebrow') }}</p><h1>{{ t('notifications.admin_title') }}</h1><p class="muted">{{ t('notifications.admin_subtitle') }}</p></div><a class="text-link" href="/settings/notifications">{{ t('notifications.back_user_settings') }}</a></div>
{% if message %}<div class="alert success">{{ message }}</div>{% endif %}{% if error %}<div class="alert">{{ error }}</div>{% endif %}
<section class="content-card notification-card"><h2>{{ t('notifications.smtp_title') }}</h2><p class="muted">{{ t('notifications.smtp_secret_note') }}</p>
<form method="post" action="/admin/notifications/smtp" class="notification-form"><input type="hidden" name="_csrf" value="{{ csrf_token }}"><label class="checkbox-inline"><input type="checkbox" name="enabled" value="1" {{ smtp and smtp.enabled ? 'checked' : '' }}> {{ t('notifications.smtp_enabled') }}</label><div class="lead-grid"><label>{{ t('notifications.smtp_host') }}<input type="text" name="host" required value="{{ smtp ? smtp.host : '' }}"></label><label>{{ t('notifications.smtp_port') }}<input type="number" min="1" max="65535" name="port" value="{{ smtp ? smtp.port : 587 }}"></label><label>{{ t('notifications.smtp_encryption') }}<select name="encryption"><option value="tls" {{ smtp and smtp.encryption == 'tls' ? 'selected' : '' }}>TLS</option><option value="ssl" {{ smtp and smtp.encryption == 'ssl' ? 'selected' : '' }}>SSL</option><option value="" {{ smtp and smtp.encryption == '' ? 'selected' : '' }}>{{ t('notifications.smtp_none') }}</option></select></label><label>{{ t('notifications.smtp_username') }}<input type="text" name="smtp_username" value="{{ smtp ? smtp.username : '' }}"></label></div><label>{{ t('notifications.smtp_password') }}<input type="password" name="password" autocomplete="new-password" placeholder="{{ smtp_has_password ? t('notifications.smtp_password_keep') : '' }}"><span class="field-help">{{ secret_configured ? t('notifications.secret_configured') : t('notifications.secret_missing') }}</span></label><div class="lead-grid"><label>{{ t('notifications.smtp_from_email') }}<input type="email" name="from_email" required value="{{ smtp ? smtp.fromEmail : '' }}"></label><label>{{ t('notifications.smtp_from_name') }}<input type="text" name="from_name" required value="{{ smtp ? smtp.fromName : 'TMS' }}"></label></div><div class="form-actions"><button type="submit">{{ t('common.save') }}</button></div></form>
<form method="post" action="/admin/notifications/smtp-test" class="inline-actions"><input type="hidden" name="_csrf" value="{{ csrf_token }}"><button type="submit" class="secondary">{{ t('notifications.smtp_test') }}</button></form></section>
<section class="content-card notification-card"><h2>{{ t('notifications.telegram_deployment_title') }}</h2><p class="muted">{{ telegram_configured ? t('notifications.telegram_deployment_ready') : t('notifications.telegram_deployment_incomplete') }}</p><form method="post" action="/admin/notifications/telegram-webhook"><input type="hidden" name="_csrf" value="{{ csrf_token }}"><button type="submit" class="secondary" {{ not telegram_configured ? 'disabled' : '' }}>{{ t('notifications.telegram_set_webhook') }}</button></form></section>
{% endblock %}
