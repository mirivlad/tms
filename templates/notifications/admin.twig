{% extends "app_layout.twig" %}
{% block title %}{{ t('notifications.admin_title') }} · TMS{% endblock %}
{% block styles %}<link rel="stylesheet" href="/assets/notifications.css">{% endblock %}
{% block content %}
<div class="page-header compact-page-header"><h1>{{ t('notifications.admin_title') }}</h1></div>
{% if message %}<div class="alert success">{{ message }}</div>{% endif %}
{% if error %}<div class="alert">{{ error }}</div>{% endif %}

<section class="content-card notification-card">
  <h2>{{ t('notifications.smtp_title') }}</h2>
  <p class="muted">{{ t('notifications.smtp_secret_note') }}</p>
  <form method="post" action="/admin/notifications/smtp" class="notification-form">
    <input type="hidden" name="_csrf" value="{{ csrf_token }}">
    <label class="checkbox-inline"><input type="checkbox" name="enabled" value="1" {{ smtp and smtp.enabled ? 'checked' : '' }}> {{ t('notifications.smtp_enabled') }}</label>
    <div class="lead-grid">
      <label>{{ t('notifications.smtp_host') }}<input type="text" name="host" required value="{{ smtp ? smtp.host : '' }}"></label>
      <label>{{ t('notifications.smtp_port') }}<input type="number" min="1" max="65535" name="port" value="{{ smtp ? smtp.port : 587 }}"></label>
      <label>{{ t('notifications.smtp_encryption') }}<select name="encryption"><option value="tls" {{ smtp and smtp.encryption == 'tls' ? 'selected' : '' }}>TLS</option><option value="ssl" {{ smtp and smtp.encryption == 'ssl' ? 'selected' : '' }}>SSL</option><option value="" {{ smtp and smtp.encryption == '' ? 'selected' : '' }}>{{ t('notifications.smtp_none') }}</option></select></label>
      <label>{{ t('notifications.smtp_username') }}<input type="text" name="smtp_username" value="{{ smtp ? smtp.username : '' }}"></label>
    </div>
    <label>{{ t('notifications.smtp_password') }}<input type="password" name="password" autocomplete="new-password" placeholder="{{ smtp_has_password ? t('notifications.secret_keep') : '' }}"><span class="field-help">{{ t('notifications.encrypted_storage') }}</span></label>
    <div class="lead-grid">
      <label>{{ t('notifications.smtp_from_email') }}<input type="email" name="from_email" required value="{{ smtp ? smtp.fromEmail : '' }}"></label>
      <label>{{ t('notifications.smtp_from_name') }}<input type="text" name="from_name" required value="{{ smtp ? smtp.fromName : 'TMS' }}"></label>
    </div>
    <div class="form-actions"><button type="submit">{{ t('common.save') }}</button></div>
  </form>
  <form method="post" action="/admin/notifications/smtp-test" class="inline-actions"><input type="hidden" name="_csrf" value="{{ csrf_token }}"><button type="submit" class="secondary">{{ t('notifications.smtp_test') }}</button></form>
</section>

<section class="content-card notification-card">
  <h2>{{ t('notifications.telegram_system_title') }}</h2>
  <p class="muted">{{ t('notifications.telegram_system_help') }}</p>
  <form method="post" action="/admin/notifications/telegram" class="notification-form">
    <input type="hidden" name="_csrf" value="{{ csrf_token }}">
    <div class="lead-grid">
      <label>{{ t('notifications.telegram_bot_name') }}<input type="text" name="bot_name" value="{{ telegram_bot_name }}" placeholder="@my_tms_bot"></label>
      <label>{{ t('notifications.telegram_bot_token') }}<input type="password" name="bot_token" autocomplete="new-password" placeholder="{{ telegram_token_configured ? t('notifications.secret_keep') : '' }}"><span class="field-help">{{ telegram_token_configured ? t('notifications.secret_stored') : t('notifications.secret_not_stored') }}</span></label>
    </div>
    <label>{{ t('notifications.telegram_webhook_secret') }}<input type="password" name="webhook_secret" autocomplete="new-password" placeholder="{{ telegram_webhook_secret_configured ? t('notifications.secret_keep') : '' }}"><span class="field-help">{{ t('notifications.telegram_webhook_secret_help') }}</span></label>
    <div class="form-actions">
      <button type="submit">{{ t('common.save') }}</button>
      <button type="submit" name="generate_webhook_secret" value="1" class="secondary">{{ t('notifications.telegram_generate_secret') }}</button>
    </div>
  </form>

  <form method="post" action="/admin/notifications/telegram" class="notification-form telegram-proxy-settings">
    <input type="hidden" name="_csrf" value="{{ csrf_token }}">
    <input type="hidden" name="section" value="proxy">
    <h3>{{ t('notifications.telegram_proxy_title') }}</h3>
    <label class="checkbox-inline"><input type="checkbox" name="proxy_enabled" value="1" {{ telegram_proxy_enabled ? 'checked' : '' }}> {{ t('notifications.telegram_proxy_enabled') }}</label>
    <label>{{ t('notifications.telegram_proxy_url') }}<input type="text" name="proxy_url" autocomplete="off" spellcheck="false" placeholder="{{ telegram_proxy_configured ? t('notifications.secret_keep') : 'http://proxy.example:1080' }}"><span class="field-help">{{ t('notifications.telegram_proxy_help') }}</span></label>
    <span class="field-help">{{ telegram_proxy_configured ? t('notifications.telegram_proxy_stored') : t('notifications.telegram_proxy_not_stored') }}</span>
    <div class="form-actions"><button type="submit">{{ t('common.save') }}</button></div>
  </form>

  <div class="notification-system-status">
    <p><strong>{{ t('notifications.telegram_webhook_url') }}:</strong> <code>{{ telegram_webhook_url }}</code></p>
    <p class="muted">{{ telegram_configured ? t('notifications.telegram_deployment_ready') : t('notifications.telegram_deployment_incomplete') }}</p>
  </div>
  <div class="inline-actions">
    <form method="post" action="/admin/notifications/telegram-test"><input type="hidden" name="_csrf" value="{{ csrf_token }}"><button type="submit" class="secondary" {{ not telegram_token_configured ? 'disabled' : '' }}>{{ t('notifications.telegram_test_connection') }}</button></form>
    <form method="post" action="/admin/notifications/telegram-webhook"><input type="hidden" name="_csrf" value="{{ csrf_token }}"><button type="submit" class="secondary" {{ not telegram_configured ? 'disabled' : '' }}>{{ t('notifications.telegram_set_webhook') }}</button></form>
  </div>
</section>
{% endblock %}
