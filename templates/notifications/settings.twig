{% extends "app_layout.twig" %}
{% block title %}{{ t('notifications.title') }} · TMS{% if chimeport_push_available %}
<section class="content-card notification-card" id="tms-push" data-csrf="{{ csrf_token }}"
  data-txt-enable="{{ t('notifications.push.enable') }}"
  data-txt-disable="{{ t('notifications.push.disable') }}"
  data-txt-unsupported="{{ t('notifications.push.unsupported') }}"
  data-txt-enabled="{{ t('notifications.push.enabled') }}"
  data-txt-disabled="{{ t('notifications.push.disabled') }}"
  data-txt-permission="{{ t('notifications.push.permission') }}"
  data-txt-failed="{{ t('notifications.push.failed') }}"
  data-txt-state-failed="{{ t('notifications.push.state_failed') }}">
  <h2>{{ t('notifications.push.title') }}</h2>
  <p class="muted">{{ t('notifications.push.description') }}</p>
  <p class="field-help" data-tms-push-status>{{ t('notifications.push.checking') }}</p>
  <button type="button" class="secondary" data-tms-push-toggle>{{ t('notifications.push.enable') }}</button>
  <h3>{{ t('notifications.push.devices') }}</h3>
  <p class="field-help">{{ t('notifications.push.devices_help') }}</p>
  {% for device in chimeport_devices %}
  <div class="notification-rule">
    <div>
      <strong>{{ device.label }}</strong>
      <p class="field-help">{{ device.kind == 'android' ? t('notifications.push.android') : t('notifications.push.browser') }}
      · {{ device.active ? t('notifications.push.active') : t('notifications.push.revoked') }}
      · {{ t('notifications.push.last_seen') }}: {{ device.last_seen_at }} UTC</p>
    </div>
    {% if device.active %}
    <form method="post" action="/settings/notifications/devices/{{ device.device_id }}/revoke">
      <input type="hidden" name="_csrf" value="{{ csrf_token }}">
      <button type="submit" class="secondary">{{ t('notifications.push.revoke') }}</button>
    </form>
    {% endif %}
  </div>
  {% else %}
  <p class="field-help">{{ t('notifications.push.none') }}</p>
  {% endfor %}
  {% if chimeport_devices|length > 0 %}
  <form method="post" action="/settings/notifications/devices/revoke-all">
    <input type="hidden" name="_csrf" value="{{ csrf_token }}">
    <button type="submit" class="secondary">{{ t('notifications.push.revoke_all') }}</button>
  </form>
  {% endif %}
</section>
<script src="/assets/chimeport-push.js" defer></script>
{% endif %}
{% endblock %}
