{% extends 'app_layout.twig' %}

{% block title %}{{ t('notifications.inbox_title') }} · TMS{% endblock %}
{% block styles %}<link rel="stylesheet" href="/assets/notifications.css">{% endblock %}

{% block content %}
<header class="page-header compact-page-header">
    <div>
        <h1>{{ t('notifications.inbox_title') }}</h1>
        <p class="muted">{{ t('notifications.inbox_subtitle') }}</p>
    </div>
    <div class="page-header-actions">
        {% if notifications %}
            <form method="post" action="/notifications/read-all">
                <input type="hidden" name="_csrf" value="{{ csrf_token }}">
                <button class="secondary compact" type="submit">{{ t('notifications.mark_all_read') }}</button>
            </form>
        {% endif %}
        <a class="text-link" href="/settings/notifications">{{ t('notifications.settings_link') }}</a>
    </div>
</header>

{% if notification_notice %}
    <p class="alert" role="status">{{ notification_notice }}</p>
{% endif %}

<section class="content-card notification-inbox">
    {% if notifications is empty %}
        <div class="empty-state">
            <strong>{{ t('notifications.inbox_empty') }}</strong>
            <span>{{ t('notifications.inbox_empty_help') }}</span>
        </div>
    {% else %}
        <div class="notification-inbox-list">
            {% for notification in notifications %}
                <article class="notification-inbox-item {{ notification.isUnread ? 'is-unread' : '' }}">
                    <a class="notification-inbox-link" href="/notifications/{{ notification.id }}/open">
                        <div class="notification-inbox-heading">
                            <strong>
                                {% if notification.notificationType == 'discussion_reply' %}
                                    {{ t('notifications.discussion_reply', {'actor': notification.actorUsername, 'context': notification.contextLabel}) }}
                                {% else %}
                                    {{ t('notifications.discussion_mention', {'actor': notification.actorUsername, 'context': notification.contextLabel}) }}
                                {% endif %}
                            </strong>
                            {% if notification.isUnread %}<span class="notification-unread-dot" aria-label="{{ t('notifications.unread') }}"></span>{% endif %}
                        </div>
                        {% if notification.bodyPreview %}<p>{{ notification.bodyPreview }}</p>{% endif %}
                        <span class="muted">{{ format_database_datetime(notification.createdAt) }}</span>
                    </a>
                </article>
            {% endfor %}
        </div>
    {% endif %}
</section>
{% endblock %}
