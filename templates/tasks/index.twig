{% extends "app_layout.twig" %}
{% import "macros/sorting.twig" as sorting %}

{% block title %}{{ t('tasks.page_title') }} · TMS{% endblock %}

{% block content %}
<div class="page-header">
    <div>
        <p class="eyebrow">{{ t('tasks.eyebrow') }}</p>
        <h1>{{ t('tasks.title') }}</h1>
        <p class="muted">{{ t('tasks.subtitle') }}</p>
    </div>
    <a class="button-link" href="/tasks/new" data-quick-add-trigger>{{ t('nav.new_task') }}</a>
</div>

<section class="content-card filters-card">
    <div class="filter-toolbar">
        <details class="filter-panel" {{ active_filters is not empty ? 'open' : '' }}>
            <summary>
                {{ t('tasks.filters') }}
                {% if active_filters is not empty %}<span class="filter-count">{{ active_filters|length }}</span>{% endif %}
            </summary>

            <form class="filters" method="get" action="/tasks">
                <input type="hidden" name="sort" value="{{ sort_field }}">
                <input type="hidden" name="order" value="{{ sort_order }}">
                <input type="hidden" name="per_page" value="{{ per_page }}">

                <label class="filter-search">
                    {{ t('tasks.search') }}
                    <input type="search" name="q" value="{{ filters.q }}" placeholder="{{ t('tasks.search_placeholder') }}">
                </label>
                <label>
                    {{ t('tasks.status') }}
                    <select name="status_id">
                        <option value="">{{ t('tasks.all_statuses') }}</option>
                        {% for id, status in status_map %}
                            <option value="{{ id }}" {{ filters.status_id == id ? 'selected' : '' }}>{{ status.name }}</option>
                        {% endfor %}
                    </select>
                </label>
                <label class="checkbox-inline filter-invert">
                    <input type="checkbox" name="status_invert" value="1" {{ filters.status_invert ? 'checked' : '' }}>
                    {{ t('tasks.exclude_status') }}
                </label>
                <label>
                    {{ t('tasks.type') }}
                    <select name="type_id">
                        <option value="">{{ t('tasks.all_types') }}</option>
                        {% for id, type in type_map %}
                            <option value="{{ id }}" {{ filters.type_id == id ? 'selected' : '' }}>{{ type.name }}</option>
                        {% endfor %}
                    </select>
                </label>
                <label>
                    {{ t('tasks.priority') }}
                    <select name="priority">
                        <option value="">{{ t('tasks.all_priorities') }}</option>
                        <option value="urgent" {{ filters.priority == 'urgent' ? 'selected' : '' }}>{{ t('priority.urgent') }}</option>
                        <option value="high" {{ filters.priority == 'high' ? 'selected' : '' }}>{{ t('priority.high') }}</option>
                        <option value="medium" {{ filters.priority == 'medium' ? 'selected' : '' }}>{{ t('priority.medium') }}</option>
                        <option value="low" {{ filters.priority == 'low' ? 'selected' : '' }}>{{ t('priority.low') }}</option>
                    </select>
                </label>
                <label>
                    {{ t('tasks.customer') }}
                    <input type="text" name="customer" value="{{ filters.customer }}" placeholder="{{ t('tasks.customer_filter_placeholder') }}">
                </label>
                <label>
                    {{ t('tasks.deadline_from') }}
                    <input type="date" name="deadline_from" value="{{ filters.deadline_from }}">
                </label>
                <label>
                    {{ t('tasks.deadline_to') }}
                    <input type="date" name="deadline_to" value="{{ filters.deadline_to }}">
                </label>
                <label>
                    {{ t('tasks.created_from') }}
                    <input type="date" name="created_from" value="{{ filters.created_from }}">
                </label>
                <label>
                    {{ t('tasks.created_to') }}
                    <input type="date" name="created_to" value="{{ filters.created_to }}">
                </label>
                <label class="checkbox-inline">
                    <input type="checkbox" name="overdue" value="1" {{ filters.overdue ? 'checked' : '' }}>
                    {{ t('tasks.overdue_only') }}
                </label>

                {% if custom_fields is not empty %}
                    <details class="custom-filter-panel field-wide" {{ custom_filters is not empty ? 'open' : '' }}>
                        <summary>{{ t('tasks.additional_fields') }}</summary>
                        <div class="custom-filter-grid">
                            {% for field in custom_fields %}
                                {% set filter_value = custom_filters[field.id]|default('') %}
                                <label class="custom-filter">
                                    {{ field.name }}
                                    {% if field.type == 'select' or field.type == 'checkbox_list' %}
                                        <select name="custom[{{ field.id }}]">
                                            <option value="">{{ t('custom_fields.any_value') }}</option>
                                            {% for option in field.options %}
                                                <option value="{{ option }}" {{ filter_value == option ? 'selected' : '' }}>{{ option }}</option>
                                            {% endfor %}
                                        </select>
                                    {% elseif field.type == 'checkbox' %}
                                        <select name="custom[{{ field.id }}]">
                                            <option value="">{{ t('custom_fields.any_value') }}</option>
                                            <option value="1" {{ filter_value == '1' ? 'selected' : '' }}>{{ t('common.yes') }}</option>
                                            <option value="0" {{ filter_value == '0' ? 'selected' : '' }}>{{ t('common.no') }}</option>
                                        </select>
                                    {% else %}
                                        <input type="text" name="custom[{{ field.id }}]" value="{{ filter_value }}" placeholder="{{ t('custom_fields.filter_placeholder') }}">
                                    {% endif %}
                                </label>
                            {% endfor %}
                        </div>
                    </details>
                {% endif %}

                <div class="filter-actions field-wide">
                    <button type="submit">{{ t('common.apply') }}</button>
                    <a class="text-link" href="/tasks">{{ t('common.reset') }}</a>
                </div>
            </form>
        </details>

        <div class="per-page-selector" aria-label="{{ t('tasks.per_page') }}">
            <span class="muted">{{ t('tasks.per_page') }}</span>
            {% for link in per_page_links %}
                <a href="{{ link.url }}" class="per-page-link {{ link.active ? 'active' : '' }}">{{ link.value }}</a>
            {% endfor %}
        </div>
    </div>

    {% if active_filters is not empty %}
        <div class="active-filters" aria-label="{{ t('tasks.active_filters') }}">
            {% for filter in active_filters %}
                <a class="filter-chip" href="{{ filter.url }}" title="{{ t('tasks.remove_filter') }}">
                    <strong>{{ filter.label }}</strong>{% if filter.value %}: {{ filter.value }}{% endif %}<span aria-hidden="true">×</span>
                </a>
            {% endfor %}
            <a class="text-link" href="/tasks">{{ t('tasks.clear_filters') }}</a>
        </div>
    {% endif %}
</section>

<section class="content-card task-table-card">
    {% if bulk_notice %}
        <div class="bulk-notice {{ bulk_notice.kind == 'error' ? 'alert' : 'success-notice' }}" role="status">{{ bulk_notice.message }}</div>
    {% endif %}

    <div class="task-table-summary">
        <strong>{{ t('tasks.total', {'count': total_tasks}) }}</strong>
        <span class="muted">{{ t('tasks.page_of', {'page': current_page, 'pages': total_pages}) }}</span>
    </div>

    {% if tasks is not empty %}
        <form id="bulk-action-form" class="bulk-actions" method="post" action="/tasks/bulk" data-bulk-form data-delete-confirm="{{ t('bulk.delete_confirm') }}">
            <input type="hidden" name="_csrf" value="{{ csrf_token }}">
            <div class="bulk-actions-heading">
                <strong>{{ t('bulk.title') }}</strong>
                <span class="muted">{{ t('bulk.selected') }}: <span data-bulk-count>0</span></span>
            </div>
            <div class="bulk-action-options">
                <label class="checkbox-inline"><input type="radio" name="action" value="delete" required> {{ t('bulk.delete') }}</label>
                <label class="checkbox-inline"><input type="radio" name="action" value="update_status"> {{ t('bulk.change_status') }}</label>
                <label class="checkbox-inline"><input type="radio" name="action" value="update_type"> {{ t('bulk.change_type') }}</label>
                <label class="checkbox-inline"><input type="radio" name="action" value="update_priority"> {{ t('bulk.change_priority') }}</label>
                <label class="checkbox-inline"><input type="radio" name="action" value="update_deadline"> {{ t('bulk.change_deadline') }}</label>
            </div>
            <div class="bulk-action-fields">
                <label data-bulk-field="update_status" hidden>
                    {{ t('bulk.new_status') }}
                    <select name="status_id">
                        {% for id, status in status_map %}<option value="{{ id }}">{{ status.name }}</option>{% endfor %}
                    </select>
                </label>
                <label data-bulk-field="update_type" hidden>
                    {{ t('bulk.new_type') }}
                    <select name="type_id">
                        <option value="">{{ t('task.no_type') }}</option>
                        {% for id, type in type_map %}<option value="{{ id }}">{{ type.name }}</option>{% endfor %}
                    </select>
                </label>
                <label data-bulk-field="update_priority" hidden>
                    {{ t('bulk.new_priority') }}
                    <select name="priority">
                        <option value="low">{{ t('priority.low') }}</option>
                        <option value="medium" selected>{{ t('priority.medium') }}</option>
                        <option value="high">{{ t('priority.high') }}</option>
                        <option value="urgent">{{ t('priority.urgent') }}</option>
                    </select>
                </label>
                <fieldset class="bulk-deadline-field" data-bulk-field="update_deadline" hidden>
                    <legend>{{ t('bulk.new_deadline') }}</legend>
                    <div class="bulk-deadline-presets">
                        <label class="checkbox-inline"><input type="radio" name="deadline_type" value="today"> {{ t('bulk.deadline_today') }}</label>
                        <label class="checkbox-inline"><input type="radio" name="deadline_type" value="tomorrow"> {{ t('bulk.deadline_tomorrow') }}</label>
                        <label class="checkbox-inline"><input type="radio" name="deadline_type" value="week"> {{ t('bulk.deadline_week') }}</label>
                        <label class="checkbox-inline"><input type="radio" name="deadline_type" value="month"> {{ t('bulk.deadline_month') }}</label>
                        <label class="checkbox-inline"><input type="radio" name="deadline_type" value="clear"> {{ t('bulk.deadline_clear') }}</label>
                        <label class="checkbox-inline"><input type="radio" name="deadline_type" value="custom"> {{ t('bulk.deadline_custom') }}</label>
                    </div>
                    <input type="datetime-local" name="custom_deadline" data-bulk-custom-deadline disabled>
                </fieldset>
            </div>
            <button type="submit" class="compact" data-bulk-submit disabled>{{ t('bulk.apply') }}</button>
        </form>
    {% endif %}
    {% if tasks is empty %}
        <div class="empty-state">
            <strong>{{ t('tasks.empty_title') }}</strong>
            <span>{{ t('tasks.empty_body') }}</span>
        </div>
    {% else %}
        <div class="table-wrap">
            <table class="task-table">
                <thead>
                    <tr>
                        <th class="bulk-select-cell"><input type="checkbox" data-bulk-select-all aria-label="{{ t('bulk.select_all') }}"></th>
                        <th>{{ sorting.head(sort_links.title, t('tasks.table.task')) }}</th>
                        <th>{{ sorting.head(sort_links.status_name, t('tasks.table.status')) }}</th>
                        <th>{{ sorting.head(sort_links.type_name, t('tasks.table.type')) }}</th>
                        <th>{{ sorting.head(sort_links.priority, t('tasks.table.priority')) }}</th>
                        <th>{{ sorting.head(sort_links.customer, t('tasks.table.customer')) }}</th>
                        {% for field in custom_fields %}
                            <th>{{ sorting.head(sort_links['custom_' ~ field.id], field.name) }}</th>
                        {% endfor %}
                        <th>{{ sorting.head(sort_links.created_at, t('tasks.table.created')) }}</th>
                        <th>{{ sorting.head(sort_links.deadline, t('tasks.table.deadline')) }}</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                {% for task in tasks %}
                    <tr>
                        <td class="bulk-select-cell">
                            <input type="checkbox" name="task_ids[]" value="{{ task.id }}" form="bulk-action-form" data-bulk-task aria-label="{{ t('bulk.select_task', {'title': task.title}) }}">
                        </td>
                        <td>
                            <a class="task-title" href="/tasks/{{ task.id }}/edit">{{ task.title }}</a>
                            {% if task.description %}<div class="muted task-preview">{{ task.description|striptags }}</div>{% endif %}
                        </td>
                        <td>
                            <span class="status-pill">
                                <span class="status-dot" style="--status-color: {{ status_map[task.statusId].color|default('#6b7280') }}"></span>
                                {{ status_map[task.statusId].name|default('—') }}
                            </span>
                        </td>
                        <td>{{ type_map[task.typeId].name|default('—') }}</td>
                        <td><span class="priority priority-{{ task.priority }}">{{ priority_labels[task.priority]|default(t('priority.medium')) }}</span></td>
                        <td>{{ customer_map[task.customerId].name|default('—') }}</td>
                        {% for field in custom_fields %}
                            {% set stored = custom_values[task.id][field.id]|default(null) %}
                            <td class="custom-value-cell">
                                {% if stored is null %}
                                    —
                                {% elseif field.type == 'checkbox' %}
                                    {{ stored == '1' ? t('common.yes') : t('common.no') }}
                                {% else %}
                                    {{ custom_field_display(field, stored) ?: '—' }}
                                {% endif %}
                            </td>
                        {% endfor %}
                        <td class="nowrap">{{ task.createdAt|date('Y-m-d H:i') }}</td>
                        <td class="nowrap">{{ task.deadline ? task.deadline|date('Y-m-d H:i') : '—' }}</td>
                        <td class="row-actions">
                            <a class="text-link" href="/tasks/{{ task.id }}/edit" data-task-preview="{{ task.id }}">{{ t('common.view') }}</a>
                            <a class="text-link" href="/tasks/{{ task.id }}/edit">{{ t('common.edit') }}</a>
                            <form method="post" action="/tasks/{{ task.id }}/delete" onsubmit="return confirm('{{ t('tasks.delete_confirm') }}')">
                                <input type="hidden" name="_csrf" value="{{ csrf_token }}">
                                <button class="danger-link" type="submit">{{ t('common.delete') }}</button>
                            </form>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}

    {% if pagination.items is not empty %}
        <nav class="pagination" aria-label="{{ t('tasks.pagination') }}">
            {% if pagination.previous %}<a class="page-link" href="{{ pagination.previous }}">‹ {{ t('tasks.previous') }}</a>{% endif %}
            {% for item in pagination.items %}
                {% if item.url %}
                    <a class="page-link {{ item.active ? 'active' : '' }}" href="{{ item.url }}">{{ item.label }}</a>
                {% else %}
                    <span class="page-gap">{{ item.label }}</span>
                {% endif %}
            {% endfor %}
            {% if pagination.next %}<a class="page-link" href="{{ pagination.next }}">{{ t('tasks.next') }} ›</a>{% endif %}
        </nav>
    {% endif %}
</section>
{% endblock %}

{% block scripts %}
<script src="/assets/bulk-actions.js" defer></script>
{% endblock %}
