{% extends 'app_layout.twig' %}
{% block title %}{{ t('discussions.title') }} · {{ task.title }} · TMS{% endblock %}
{% block styles %}<link rel="stylesheet" href="/assets/discussions.css"><link rel="stylesheet" href="/assets/collaboration.css">{% endblock %}

{% block content %}
<div class="discussion-workspace task-discussion-workspace">
    <header class="discussion-task-header">
        <div>
            <a class="discussion-kicker" href="/projects/{{ project.id }}/discussion">{{ project.name }}</a>
            <h1>{{ task.title }}</h1>
            <div class="discussion-context-summary">
                <span>{{ t('discussions.message_count', {'count': discussion_stat.count}) }}</span>
                {% if discussion_stat.unread > 0 %}
                    <span class="discussion-unread-badge">{{ t('discussions.unread_count', {'count': discussion_stat.unread}) }}</span>
                {% endif %}
            </div>
        </div>
        <div class="page-header-actions">
            <a class="button-link secondary-link compact" href="/tasks/{{ task.id }}/edit">{{ t('common.edit') }}</a>
            <a class="text-link" href="/tasks">{{ t('task_form.back') }}</a>
        </div>
    </header>

    {% include 'discussions/thread.twig' %}
</div>
{% endblock %}

{% block scripts %}<script src="/assets/discussions.js" defer></script>{% endblock %}
