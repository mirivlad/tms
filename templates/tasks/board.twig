{% extends "app_layout.twig" %}

{% block title %}Board · TMS{% endblock %}

{% block content %}
<div class="page-header">
    <div>
        <p class="eyebrow">Board</p>
        <h1>Task board</h1>
        <p class="muted">Drag cards between columns or use the Move to selector. Completed columns keep only tasks updated during the last seven days.</p>
    </div>
    <a class="button-link" href="/tasks/new">New task</a>
</div>

<div class="board" role="list" data-board>
    {% for status in statuses %}
        <section class="board-column" role="listitem" data-status-id="{{ status.id }}">
            <header class="board-column-header">
                <div>
                    <span class="status-dot" style="--status-color: {{ status.color }}"></span>
                    <strong>{{ status.name }}</strong>
                </div>
                <span class="count-badge" data-count>{{ tasks_by_status[status.id]|length }}</span>
            </header>

            <div class="board-cards" data-status-id="{{ status.id }}">
                {% for task in tasks_by_status[status.id] %}
                    <article class="task-card" draggable="true" data-task-id="{{ task.id }}">
                        <div class="task-card-topline">
                            <span class="priority priority-{{ task.priority }}">{{ priority_labels[task.priority]|default('Medium') }}</span>
                            {% if task.deadline %}<span class="muted small">{{ task.deadline|date('Y-m-d H:i') }}</span>{% endif %}
                        </div>
                        <a class="task-card-title" href="/tasks/{{ task.id }}/edit">{{ task.title }}</a>
                        {% if task.description %}<p class="task-card-description">{{ task.description }}</p>{% endif %}
                        <div class="task-card-meta">
                            {% if type_map[task.typeId] is defined %}<span>{{ type_map[task.typeId].name }}</span>{% endif %}
                            {% if customer_map[task.customerId] is defined %}<span>{{ customer_map[task.customerId].name }}</span>{% endif %}
                        </div>
                        <form class="move-form" method="post" action="/tasks/{{ task.id }}/status">
                            <input type="hidden" name="_csrf" value="{{ csrf_token }}">
                            <label>
                                Move to
                                <select name="status_id" onchange="this.form.submit()">
                                    {% for target in statuses %}
                                        <option value="{{ target.id }}" {{ target.id == status.id ? 'selected' : '' }}>{{ target.name }}</option>
                                    {% endfor %}
                                </select>
                            </label>
                        </form>
                    </article>
                {% endfor %}
                <div class="board-empty" {{ tasks_by_status[status.id] is not empty ? 'hidden' : '' }}>No tasks</div>
            </div>
        </section>
    {% endfor %}
</div>
<script src="/assets/board.js" defer></script>
{% endblock %}
