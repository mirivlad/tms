{% extends "app_layout.twig" %}

{% block title %}{{ t('board.page_title') }} · TMS{% endblock %}
{% block styles %}<link rel="stylesheet" href="/assets/board-dnd.css">{% endblock %}

{% block content %}
<div class="page-header compact-page-header">
    <h1>{{ t('board.title') }}</h1>
</div>

<section class="content-card filters-card">
    <form class="filters" method="get" action="/board">
        <label>
            {{ t('projects.task_project') }}
            <select name="project" onchange="this.form.submit()">
                <option value="">{{ t('projects.all_projects') }}</option>
                <option value="none" {{ project_filter == 'none' ? 'selected' : '' }}>{{ t('projects.no_project') }}</option>
                {% for project in projects %}
                    <option value="{{ project.id }}" {{ project_filter == (project.id ~ '') ? 'selected' : '' }}>{{ project.name }}</option>
                {% endfor %}
            </select>
        </label>
        <noscript><button type="submit">{{ t('common.apply') }}</button></noscript>
    </form>
</section>

<div class="board" role="list" data-board>
    {% for status in statuses %}
        <section class="board-column" role="listitem" data-status-id="{{ status.id }}" style="--status-color: {{ status.color }}">
            <header class="board-column-header">
                <div>
                    <span class="status-dot" style="--status-color: {{ status.color }}"></span>
                    <strong>{{ status.name }}</strong>
                </div>
                <span class="count-badge" data-count>{{ tasks_by_status[status.id]|length }}</span>
            </header>

            <div class="board-cards" data-status-id="{{ status.id }}">
                {% for task in tasks_by_status[status.id] %}
                    <article class="task-card" draggable="true" data-task-id="{{ task.id }}">
                        <div class="task-card-topline">
                            <span class="priority priority-{{ task.priority }}">{{ priority_labels[task.priority]|default(t('priority.medium')) }}</span>
                            {% if task.deadline %}<span class="muted small">{{ task.deadline|date('Y-m-d H:i') }}</span>{% endif %}
                        </div>
                        <a class="task-card-title" href="/tasks/{{ task.id }}/edit" data-task-preview="{{ task.id }}">{{ task.title }}</a>
                        {% if task.description %}<p class="task-card-description">{{ task.description|striptags }}</p>{% endif %}
                        <div class="task-card-meta">
                            {% if project_map[task.projectId] is defined %}<span>{{ project_map[task.projectId].name }}</span>{% endif %}
                            {% if assignee_map[task.assigneeUserId] is defined %}<span>{{ t('task_form.assignee') }}: {{ assignee_map[task.assigneeUserId].username }}</span>{% endif %}
                            {% if type_map[task.typeId] is defined %}<span>{{ type_map[task.typeId].name }}</span>{% endif %}
                            {% if customer_map[task.customerId] is defined %}<span>{{ customer_map[task.customerId].name }}</span>{% endif %}
                        </div>
                        <details class="move-menu">
                            <summary>{{ t('board.move_to') }}</summary>
                            <form class="move-form" method="post" action="/tasks/{{ task.id }}/status">
                                <input type="hidden" name="_csrf" value="{{ csrf_token }}">
                                <select name="status_id" aria-label="{{ t('board.move_to') }}" onchange="this.form.submit()">
                                    {% for target in statuses %}
                                        <option value="{{ target.id }}" {{ target.id == status.id ? 'selected' : '' }}>{{ target.name }}</option>
                                    {% endfor %}
                                </select>
                            </form>
                        </details>
                    </article>
                {% endfor %}
                <div class="board-empty" {{ tasks_by_status[status.id] is not empty ? 'hidden' : '' }}>{{ t('common.no_tasks') }}</div>
            </div>
        </section>
    {% endfor %}
</div>
<script src="/assets/board.js" defer></script>
{% endblock %}
