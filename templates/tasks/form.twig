{% extends "app_layout.twig" %}

{% block title %}{{ task ? 'Edit task' : 'New task' }} · TMS{% endblock %}

{% block content %}
<div class="page-header">
    <div>
        <p class="eyebrow">{{ task ? 'Edit task' : 'New task' }}</p>
        <h1>{{ task ? task.title : 'Create a task' }}</h1>
        <p class="muted">Title, status, priority and deadline first; extra capabilities will be layered on later.</p>
    </div>
    <a class="text-link" href="/tasks">Back to tasks</a>
</div>

<section class="content-card form-card">
    {% if error %}<div class="alert">{{ error }}</div>{% endif %}

    <form class="task-form" method="post" action="{{ task ? '/tasks/' ~ task.id : '/tasks' }}">
        <input type="hidden" name="_csrf" value="{{ csrf_token }}">

        <label class="field-wide">
            Title
            <input type="text" name="title" maxlength="255" required autofocus value="{{ form.title|default('') }}">
        </label>

        <label class="field-wide">
            Description
            <textarea name="description" rows="8" placeholder="Notes, context, links…">{{ form.description|default('') }}</textarea>
            <span class="field-help">Plain text for now. Rich-text formatting will return only after the sanitizer contract is explicit.</span>
        </label>

        <label>
            Status
            <select name="status_id" required>
                {% for status in statuses %}
                    <option value="{{ status.id }}" {{ form.status_id == status.id ? 'selected' : '' }}>{{ status.name }}</option>
                {% endfor %}
            </select>
        </label>

        <label>
            Type
            <select name="type_id">
                <option value="">No type</option>
                {% for type in types %}
                    <option value="{{ type.id }}" {{ form.type_id == type.id ? 'selected' : '' }}>{{ type.name }}</option>
                {% endfor %}
            </select>
        </label>

        <label>
            Priority
            <select name="priority">
                <option value="low" {{ form.priority == 'low' ? 'selected' : '' }}>Low</option>
                <option value="medium" {{ form.priority == 'medium' ? 'selected' : '' }}>Medium</option>
                <option value="high" {{ form.priority == 'high' ? 'selected' : '' }}>High</option>
                <option value="urgent" {{ form.priority == 'urgent' ? 'selected' : '' }}>Urgent</option>
            </select>
        </label>

        <label>
            Deadline
            <input type="datetime-local" name="deadline" value="{{ form.deadline|default('') }}">
        </label>

        <label class="field-wide">
            Customer
            <input type="text" name="customer" maxlength="255" list="customer-list" autocomplete="off" value="{{ form.customer|default('') }}" placeholder="Existing or new customer">
            <datalist id="customer-list">
                {% for customer in customers %}<option value="{{ customer.name }}"></option>{% endfor %}
            </datalist>
            <span class="field-help">If the name does not exist yet, TMS creates it automatically when the task is saved.</span>
        </label>

        <div class="form-actions field-wide">
            <button type="submit">{{ task ? 'Save changes' : 'Create task' }}</button>
            <a class="button-link secondary-link" href="/tasks">Cancel</a>
        </div>
    </form>
</section>
{% endblock %}
