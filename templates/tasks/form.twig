{% extends "app_layout.twig" %}

{% block title %}{{ task ? t('task_form.edit_title') : t('task_form.new_title') }} · TMS{% endblock %}
{% block styles %}<link rel="stylesheet" href="/assets/task-form.css"><link rel="stylesheet" href="/assets/discussions.css">{% endblock %}

{% block content %}
<div class="page-header compact-page-header">
    <h1>{{ task ? task.title : t('task_form.create_heading') }}</h1>
    <div class="page-header-actions">
        {% if task %}
            <a class="button-link secondary-link compact" href="/tasks/{{ task.id }}/history">{{ t('activity.title') }}</a>
        {% endif %}
        {% if task and discussion_enabled %}
            <a class="button-link secondary-link compact discussion-link" href="/tasks/{{ task.id }}/discussion">
                {{ t('discussions.open') }}
                <span class="count-badge">{{ discussion_stat.count }}</span>
                {% if discussion_stat.unread > 0 %}
                    <span class="discussion-unread-badge">{{ discussion_stat.unread }}</span>
                {% endif %}
            </a>
        {% endif %}
        <a class="text-link" href="/tasks">{{ t('task_form.back') }}</a>
    </div>
</div>

<section class="content-card form-card">
    {% if error %}<div class="alert">{{ error }}</div>{% endif %}

    <form class="task-form" method="post" action="{{ task ? '/tasks/' ~ task.id : '/tasks' }}"
      data-task-form
      data-status-options-url="{{ status_options_url }}"
      data-custom-fields-url="{{ custom_fields_url }}"
      data-assignee-options-url="{{ assignee_options_url }}"
      data-load-error-message="{{ t('task_form.dynamic_load_error') }}"
      data-task-id="{{ task ? task.id : '' }}">
        <input type="hidden" name="_csrf" value="{{ csrf_token }}">
        <div class="alert field-wide" role="alert" data-task-load-error hidden></div>

        <label class="field-wide">
            {{ t('task_form.title') }}
            <input type="text" name="title" maxlength="255" required autofocus value="{{ form.title|default('') }}">
        </label>

        <div class="field-wide form-field rich-editor" data-rich-editor data-link-prompt="{{ t('task_form.rich_link_prompt') }}">
            <label for="task-description-source">{{ t('task_form.description') }}</label>
            <div class="rich-toolbar" role="toolbar" aria-label="{{ t('task_form.rich_toolbar_aria') }}">
                <button type="button" class="secondary compact" data-command="bold" title="{{ t('task_form.rich_bold') }}"><strong>B</strong></button>
                <button type="button" class="secondary compact" data-command="italic" title="{{ t('task_form.rich_italic') }}"><em>I</em></button>
                <button type="button" class="secondary compact" data-command="underline" title="{{ t('task_form.rich_underline') }}"><u>U</u></button>
                <button type="button" class="secondary compact" data-command="insertUnorderedList" title="{{ t('task_form.rich_bullets') }}">• {{ t('task_form.rich_list_short') }}</button>
                <button type="button" class="secondary compact" data-command="insertOrderedList" title="{{ t('task_form.rich_numbered') }}">1. {{ t('task_form.rich_list_short') }}</button>
                <button type="button" class="secondary compact" data-command="formatBlock" data-value="blockquote" title="{{ t('task_form.rich_quote') }}">❯</button>
                <button type="button" class="secondary compact" data-command="createLink" title="{{ t('task_form.rich_link') }}">{{ t('task_form.rich_link_short') }}</button>
                <button type="button" class="secondary compact" data-command="unlink" title="{{ t('task_form.rich_unlink') }}">× {{ t('task_form.rich_link_short') }}</button>
                <button type="button" class="secondary compact" data-command="removeFormat" title="{{ t('task_form.rich_clear') }}">{{ t('task_form.rich_clear_short') }}</button>
            </div>
            <textarea id="task-description-source" class="rich-source" name="description" rows="8" placeholder="{{ t('task_form.description_placeholder') }}">{{ sanitize_task_html(form.description|default('')) }}</textarea>
            <div class="rich-surface" contenteditable="true" role="textbox" aria-multiline="true" aria-label="{{ t('task_form.description') }}" data-placeholder="{{ t('task_form.description_placeholder') }}" hidden></div>
            <span class="field-help">{{ t('task_form.description_help') }}</span>
        </div>

        <label>
            {{ t('projects.task_project') }}
            <select name="project_id" data-project-select {{ scope_locked ? 'disabled' : '' }}>
                <option value="" data-team-owned="0">{{ t('projects.no_project') }}</option>
                {% for project in projects %}
                    <option value="{{ project.id }}"
                            data-team-owned="{{ project.ownerTeamId ? '1' : '0' }}"
                            {{ form.project_id == project.id ? 'selected' : '' }}>{{ project.name }}</option>
                {% endfor %}
            </select>
            {% if scope_locked %}
                <input type="hidden" name="project_id" value="{{ form.project_id|default('') }}">
                <span class="field-help">{{ t('task_form.project_locked_for_collaborator') }}</span>
            {% endif %}
        </label>

        <label>
            {{ t('task_form.status') }}
            <select name="status_id" required data-status-select>
                {% for status in statuses %}
                    <option value="{{ status.id }}" {{ form.status_id == status.id ? 'selected' : '' }}>{{ status.name }}</option>
                {% endfor %}
            </select>
        </label>

        <label data-personal-metadata {{ team_project ? 'hidden' : '' }}>
            {{ t('task_form.type') }}
            <select name="type_id" {{ team_project ? 'disabled' : '' }}>
                <option value="">{{ t('task_form.no_type') }}</option>
                {% for type in types %}
                    <option value="{{ type.id }}" {{ form.type_id == type.id ? 'selected' : '' }}>{{ type.name }}</option>
                {% endfor %}
            </select>
        </label>

        <label data-assignee-field {{ team_project ? '' : 'hidden' }}>
            {{ t('task_form.assignee') }}
            <select name="assignee_user_id" data-assignee-select data-unassigned-label="{{ t('task_form.unassigned') }}" {{ team_project ? '' : 'disabled' }}>
                <option value="">{{ t('task_form.unassigned') }}</option>
                {% for member in assignees %}
                    <option value="{{ member.userId }}" {{ form.assignee_user_id == member.userId ? 'selected' : '' }}>
                        {{ member.username }}{% if member.role == 'lead' %} · {{ t('teams.role.lead') }}{% endif %}
                    </option>
                {% endfor %}
            </select>
            <span class="field-help">{{ t('task_form.assignee_help') }}</span>
        </label>

        <label>
            {{ t('task_form.priority') }}
            <select name="priority">
                <option value="low" {{ form.priority == 'low' ? 'selected' : '' }}>{{ t('priority.low') }}</option>
                <option value="medium" {{ form.priority == 'medium' ? 'selected' : '' }}>{{ t('priority.medium') }}</option>
                <option value="high" {{ form.priority == 'high' ? 'selected' : '' }}>{{ t('priority.high') }}</option>
                <option value="urgent" {{ form.priority == 'urgent' ? 'selected' : '' }}>{{ t('priority.urgent') }}</option>
            </select>
        </label>

        <label>
            {{ t('task_form.deadline') }}
            <input type="datetime-local" name="deadline" value="{{ form.deadline|default('') }}">
        </label>

        <div class="field-wide form-field customer-autocomplete" data-personal-metadata {{ team_project ? 'hidden' : '' }}>
            <label for="task-customer">{{ t('task_form.customer') }}</label>
            <div class="customer-autocomplete-control">
                <input id="task-customer" type="text" name="customer" maxlength="255" autocomplete="off"
                       value="{{ form.customer|default('') }}" placeholder="{{ t('task_form.customer_placeholder') }}"
                       data-customer-autocomplete data-search-url="/api/customers/search"
                       aria-autocomplete="list" aria-controls="customer-suggestions" aria-expanded="false"
                       {{ team_project ? 'disabled' : '' }}>
                <div id="customer-suggestions" class="autocomplete-results" role="listbox" hidden></div>
            </div>
            <span class="field-help">{{ t('task_form.customer_help') }}</span>
        </div>

        <p class="field-wide muted" data-team-metadata-help {{ team_project ? '' : 'hidden' }}>
            {{ t('task_form.team_project_metadata_help') }}
        </p>

        <div class="field-wide task-custom-fields-container" data-custom-fields-container>
            {% include 'tasks/_custom_fields.twig' %}
        </div>

        <div class="form-actions field-wide">
            <button type="submit">{{ task ? t('task_form.save_changes') : t('task_form.create_task') }}</button>
            <a class="button-link secondary-link" href="/tasks">{{ t('common.cancel') }}</a>
        </div>
    </form>
</section>

{% if task %}
    <section id="checklist" class="content-card checklist-card">
        <div class="section-heading checklist-heading">
            <div>
                <h2>{{ t('checklist.title') }}</h2>
                <p class="muted">{{ t('checklist.help') }}</p>
            </div>
            {% if checklist_progress.total > 0 %}
                <span class="checklist-progress">{{ t('checklist.progress', {
                    'completed': checklist_progress.completed,
                    'total': checklist_progress.total
                }) }}</span>
            {% endif %}
        </div>

        {% if checklist_notice %}
            <div class="{{ checklist_notice.kind == 'error' ? 'alert' : 'success-notice' }}">{{ checklist_notice.message }}</div>
        {% endif %}

        <form class="checklist-add" method="post" action="/tasks/{{ task.id }}/checklist">
            <input type="hidden" name="_csrf" value="{{ csrf_token }}">
            <input type="text" name="text" maxlength="500" required placeholder="{{ t('checklist.add_placeholder') }}">
            <button type="submit" class="compact">{{ t('checklist.add') }}</button>
        </form>

        {% if checklist_items is empty %}
            <p class="muted checklist-empty">{{ t('checklist.empty') }}</p>
        {% else %}
            <div class="checklist-list">
                {% for item in checklist_items %}
                    <div class="checklist-row {{ item.isCompleted ? 'is-completed' : '' }}">
                        <form method="post" action="/tasks/{{ task.id }}/checklist/{{ item.id }}/toggle">
                            <input type="hidden" name="_csrf" value="{{ csrf_token }}">
                            <button type="submit" class="checklist-toggle secondary compact"
                                    title="{{ item.isCompleted ? t('checklist.reopen') : t('checklist.complete') }}"
                                    aria-label="{{ item.isCompleted ? t('checklist.reopen') : t('checklist.complete') }}">
                                {{ item.isCompleted ? '✓' : '○' }}
                            </button>
                        </form>

                        <form class="checklist-edit" method="post" action="/tasks/{{ task.id }}/checklist/{{ item.id }}">
                            <input type="hidden" name="_csrf" value="{{ csrf_token }}">
                            <input type="text" name="text" maxlength="500" required value="{{ item.text }}">
                            <button type="submit" class="secondary compact">{{ t('checklist.save') }}</button>
                        </form>

                        <div class="checklist-actions">
                            <form method="post" action="/tasks/{{ task.id }}/checklist/{{ item.id }}/move">
                                <input type="hidden" name="_csrf" value="{{ csrf_token }}">
                                <input type="hidden" name="direction" value="up">
                                <button type="submit" class="secondary compact" title="{{ t('checklist.move_up') }}" aria-label="{{ t('checklist.move_up') }}">↑</button>
                            </form>
                            <form method="post" action="/tasks/{{ task.id }}/checklist/{{ item.id }}/move">
                                <input type="hidden" name="_csrf" value="{{ csrf_token }}">
                                <input type="hidden" name="direction" value="down">
                                <button type="submit" class="secondary compact" title="{{ t('checklist.move_down') }}" aria-label="{{ t('checklist.move_down') }}">↓</button>
                            </form>
                            <form method="post" action="/tasks/{{ task.id }}/checklist/{{ item.id }}/delete"
                                  onsubmit="return confirm('{{ t('checklist.delete_confirm')|e('js') }}')">
                                <input type="hidden" name="_csrf" value="{{ csrf_token }}">
                                <button type="submit" class="secondary compact danger-link">{{ t('checklist.delete') }}</button>
                            </form>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </section>
{% endif %}

{% if task and can_manage_recurrence %}
    <section id="recurrence" class="content-card form-card">
        <div class="section-heading">
            <div>
                <h2>{{ t('recurrence.title') }}</h2>
                <p class="muted">{{ t('recurrence.help') }}</p>
            </div>
            {% if recurrence %}
                <span class="status-badge">{{ recurrence.isActive ? t('recurrence.active') : t('recurrence.paused') }}</span>
            {% endif %}
        </div>

        {% if recurrence_notice %}
            <div class="{{ recurrence_notice.kind == 'error' ? 'alert' : 'success-notice' }}">{{ recurrence_notice.message }}</div>
        {% endif %}
        {% if recurrence and recurrence.lastError %}
            <div class="alert">{{ t('recurrence.paused_reason', {'reason': recurrence.lastError}) }}</div>
        {% endif %}

        <form class="task-form" method="post" action="/tasks/{{ task.id }}/recurrence">
            <input type="hidden" name="_csrf" value="{{ csrf_token }}">

            <label>
                {{ t('recurrence.mode') }}
                <select name="mode" required>
                    {% set recurrence_mode = recurrence ? recurrence.mode : 'daily' %}
                    <option value="daily" {{ recurrence_mode == 'daily' ? 'selected' : '' }}>{{ t('recurrence.mode.daily') }}</option>
                    <option value="weekly" {{ recurrence_mode == 'weekly' ? 'selected' : '' }}>{{ t('recurrence.mode.weekly') }}</option>
                    <option value="monthly" {{ recurrence_mode == 'monthly' ? 'selected' : '' }}>{{ t('recurrence.mode.monthly') }}</option>
                    <option value="interval" {{ recurrence_mode == 'interval' ? 'selected' : '' }}>{{ t('recurrence.mode.interval') }}</option>
                    <option value="after_completion" {{ recurrence_mode == 'after_completion' ? 'selected' : '' }}>{{ t('recurrence.mode.after_completion') }}</option>
                </select>
            </label>

            <label>
                {{ t('recurrence.interval') }}
                <input type="number" name="interval_value" min="1" max="3650"
                       value="{{ recurrence ? recurrence.intervalValue : 1 }}">
                <span class="field-help">{{ t('recurrence.interval_help') }}</span>
            </label>

            <label>
                {{ t('recurrence.spawn_status') }}
                <select name="spawn_status_id" required>
                    {% for status in recurrence_statuses %}
                        <option value="{{ status.id }}"
                            {{ (recurrence and recurrence.spawnStatusId == status.id)
                               or (not recurrence and status.isDefault) ? 'selected' : '' }}>
                            {{ status.name }}
                        </option>
                    {% endfor %}
                </select>
                <span class="field-help">{{ t('recurrence.spawn_status_help') }}</span>
            </label>

            <div class="form-actions">
                <button type="submit">{{ recurrence ? t('recurrence.save') : t('recurrence.enable') }}</button>
            </div>
        </form>

        {% if recurrence %}
            <dl class="admin-user-facts">
                <dt>{{ t('recurrence.next') }}</dt>
                <dd>{{ recurrence.nextDeadline ?: t('recurrence.after_completion_waiting') }}</dd>
                <dt>{{ t('recurrence.generated') }}</dt>
                <dd>{{ recurrence.sequence }}</dd>
            </dl>
            <form method="post" action="/tasks/{{ task.id }}/recurrence/delete"
                  onsubmit="return confirm('{{ t('recurrence.delete_confirm')|e('js') }}')">
                <input type="hidden" name="_csrf" value="{{ csrf_token }}">
                <button type="submit" class="secondary danger-link">{{ t('recurrence.disable') }}</button>
            </form>
        {% endif %}
    </section>
{% endif %}

{% if task %}
    {% set attachments = task_attachments(task.id) %}
    <section class="content-card attachment-card">
        <div class="attachment-heading">
            <div>
                <h2>{{ t('attachments.title') }}</h2>
                <p class="muted">{{ t('attachments.help', {'size': attachment_max_mib, 'extensions': attachment_allowed_extensions|join(', ')}) }}</p>
            </div>
        </div>

        <form class="attachment-upload" method="post" action="/tasks/{{ task.id }}/attachments" enctype="multipart/form-data">
            <input type="hidden" name="_csrf" value="{{ csrf_token }}">
            <label>
                {{ t('attachments.choose') }}
                <input type="file" name="attachments[]" multiple required>
            </label>
            <button type="submit">{{ t('attachments.upload') }}</button>
        </form>

        {% if attachments is empty %}
            <p class="muted attachment-empty">{{ t('attachments.empty') }}</p>
        {% else %}
            <div class="attachment-list">
                {% for attachment in attachments %}
                    <div class="attachment-row">
                        <div class="attachment-details">
                            <a class="text-link attachment-name" href="/tasks/{{ task.id }}/attachments/{{ attachment.id }}">{{ attachment.originalName }}</a>
                            <span class="muted attachment-meta">
                                {% if attachment.fileSize >= 1048576 %}
                                    {{ (attachment.fileSize / 1048576)|number_format(1, '.', ' ') }} MiB
                                {% else %}
                                    {{ (attachment.fileSize / 1024)|number_format(1, '.', ' ') }} KiB
                                {% endif %}
                                · {{ format_database_datetime(attachment.createdAt) }}
                            </span>
                        </div>
                        <form method="post" action="/tasks/{{ task.id }}/attachments/{{ attachment.id }}/delete" onsubmit="return confirm('{{ t('attachments.delete_confirm')|e('js') }}')">
                            <input type="hidden" name="_csrf" value="{{ csrf_token }}">
                            <button type="submit" class="secondary compact">{{ t('attachments.delete') }}</button>
                        </form>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </section>
{% endif %}
{% endblock %}

{% block scripts %}<script src="/assets/task-form.js" defer></script>{% endblock %}
