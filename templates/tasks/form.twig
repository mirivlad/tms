{% extends "app_layout.twig" %}

{% block title %}{{ task ? t('task_form.edit_title') : t('task_form.new_title') }} · TMS{% endblock %}

{% block content %}
<div class="page-header">
    <div>
        <p class="eyebrow">{{ task ? t('task_form.edit_title') : t('task_form.new_title') }}</p>
        <h1>{{ task ? task.title : t('task_form.create_heading') }}</h1>
        <p class="muted">{{ t('task_form.subtitle') }}</p>
    </div>
    <a class="text-link" href="/tasks">{{ t('task_form.back') }}</a>
</div>

<section class="content-card form-card">
    {% if error %}<div class="alert">{{ error }}</div>{% endif %}

    <form class="task-form" method="post" action="{{ task ? '/tasks/' ~ task.id : '/tasks' }}">
        <input type="hidden" name="_csrf" value="{{ csrf_token }}">

        <label class="field-wide">
            {{ t('task_form.title') }}
            <input type="text" name="title" maxlength="255" required autofocus value="{{ form.title|default('') }}">
        </label>

        <label class="field-wide">
            {{ t('task_form.description') }}
            <textarea name="description" rows="8" placeholder="{{ t('task_form.description_placeholder') }}">{{ form.description|default('') }}</textarea>
            <span class="field-help">{{ t('task_form.description_help') }}</span>
        </label>

        <label>
            {{ t('task_form.status') }}
            <select name="status_id" required>
                {% for status in statuses %}
                    <option value="{{ status.id }}" {{ form.status_id == status.id ? 'selected' : '' }}>{{ status.name }}</option>
                {% endfor %}
            </select>
        </label>

        <label>
            {{ t('task_form.type') }}
            <select name="type_id">
                <option value="">{{ t('task_form.no_type') }}</option>
                {% for type in types %}
                    <option value="{{ type.id }}" {{ form.type_id == type.id ? 'selected' : '' }}>{{ type.name }}</option>
                {% endfor %}
            </select>
        </label>

        <label>
            {{ t('task_form.priority') }}
            <select name="priority">
                <option value="low" {{ form.priority == 'low' ? 'selected' : '' }}>{{ t('priority.low') }}</option>
                <option value="medium" {{ form.priority == 'medium' ? 'selected' : '' }}>{{ t('priority.medium') }}</option>
                <option value="high" {{ form.priority == 'high' ? 'selected' : '' }}>{{ t('priority.high') }}</option>
                <option value="urgent" {{ form.priority == 'urgent' ? 'selected' : '' }}>{{ t('priority.urgent') }}</option>
            </select>
        </label>

        <label>
            {{ t('task_form.deadline') }}
            <input type="datetime-local" name="deadline" value="{{ form.deadline|default('') }}">
        </label>

        <label class="field-wide">
            {{ t('task_form.customer') }}
            <input type="text" name="customer" maxlength="255" list="customer-list" autocomplete="off" value="{{ form.customer|default('') }}" placeholder="{{ t('task_form.customer_placeholder') }}">
            <datalist id="customer-list">
                {% for customer in customers %}<option value="{{ customer.name }}"></option>{% endfor %}
            </datalist>
            <span class="field-help">{{ t('task_form.customer_help') }}</span>
        </label>

        <div class="form-actions field-wide">
            <button type="submit">{{ task ? t('task_form.save_changes') : t('task_form.create_task') }}</button>
            <a class="button-link secondary-link" href="/tasks">{{ t('common.cancel') }}</a>
        </div>
    </form>
</section>
{% endblock %}
